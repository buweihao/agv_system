<Window x:Class="AgvDispatcher.DebugDashboard.Views.DebugDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AgvDispatcher.DebugDashboard.Converters"
        Title="AGV 调试数据大面板"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        Background="#050B14">
    <Window.Resources>
        <converters:TrafficStateBrushConverter x:Key="TrafficStateBrushConverter"/>
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#0A111E"/>
            <Setter Property="BorderBrush" Value="#1A2B3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="DashboardDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Background" Value="#08111E"/>
            <Setter Property="Foreground" Value="#D8E8F8"/>
            <Setter Property="RowBackground" Value="#0A1422"/>
            <Setter Property="AlternatingRowBackground" Value="#0D1A2A"/>
            <Setter Property="BorderBrush" Value="#1A2B3C"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#1A2B3C"/>
            <Setter Property="VerticalGridLinesBrush" Value="#1A2B3C"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="Background" Value="#D8E8F8"/>
                        <Setter Property="BorderBrush" Value="#1A2B3C"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,6"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8E8F8"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StateCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
            <Setter Property="Foreground" Value="{Binding State, Converter={StaticResource TrafficStateBrushConverter}}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SummaryValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8FA8BF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="64" Background="#050B14" Margin="16,10,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="AGV 调试数据大面板"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding LastRefreshTime, StringFormat=刷新：{0:yyyy-MM-dd HH:mm:ss}}"
                           Foreground="#8FA8BF"
                           FontSize="14"
                           Margin="20,4,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="自动刷新"
                          IsChecked="{Binding IsAutoRefreshEnabled}"
                          Foreground="#D8E8F8"
                          VerticalAlignment="Center"
                          Margin="0,0,14,0"/>
                <ComboBox Width="72"
                          ItemsSource="{Binding RefreshIntervals}"
                          SelectedItem="{Binding SelectedRefreshIntervalSeconds}"
                          Margin="0,0,14,0"/>
                <TextBlock Text="秒"
                           Foreground="#8FA8BF"
                           VerticalAlignment="Center"
                           Margin="-10,0,14,0"/>
                <Button Content="刷新"
                        Command="{Binding RefreshCommand}"
                        Width="72"
                        Height="32"
                        Margin="0,0,14,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Width="260"
                         Height="32"
                         VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>

        <StatusBar DockPanel.Dock="Bottom" Background="#07101B" Foreground="#B8C7D9">
            <StatusBarItem Content="{Binding StatusMessage}"/>
            <Separator/>
            <StatusBarItem Content="{Binding IsRefreshing, StringFormat=刷新中：{0}}"/>
        </StatusBar>

        <TabControl Margin="16,0,16,16"
                    Background="#050B14"
                    BorderBrush="#1A2B3C">
            <TabItem Header="总览">
                <Grid Margin="8">
                    <UniformGrid Columns="4" Rows="2">
                        <Border Style="{StaticResource PanelBorderStyle}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="{Binding TaskCount}" Style="{StaticResource SummaryValueStyle}"/>
                                <TextBlock Text="当前任务" Style="{StaticResource SummaryLabelStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorderStyle}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="{Binding RunningTaskCount}" Style="{StaticResource SummaryValueStyle}"/>
                                <TextBlock Text="Running 任务" Style="{StaticResource SummaryLabelStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorderStyle}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="{Binding WaitingForTrafficTaskCount}" Style="{StaticResource SummaryValueStyle}"/>
                                <TextBlock Text="WaitingForTraffic" Style="{StaticResource SummaryLabelStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorderStyle}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="{Binding FaultVehicleCount}" Style="{StaticResource SummaryValueStyle}"/>
                                <TextBlock Text="Fault 车辆" Style="{StaticResource SummaryLabelStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorderStyle}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="{Binding LockedResourceCount}" Style="{StaticResource SummaryValueStyle}"/>
                                <TextBlock Text="Locked 资源" Style="{StaticResource SummaryLabelStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorderStyle}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="{Binding OccupiedResourceCount}" Style="{StaticResource SummaryValueStyle}"/>
                                <TextBlock Text="Occupied 资源" Style="{StaticResource SummaryLabelStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorderStyle}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="{Binding BlockedResourceCount}" Style="{StaticResource SummaryValueStyle}"/>
                                <TextBlock Text="Blocked 资源" Style="{StaticResource SummaryLabelStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorderStyle}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="{Binding RecentOkapiErrorCount}" Style="{StaticResource SummaryValueStyle}"/>
                                <TextBlock Text="Okapi 错误" Style="{StaticResource SummaryLabelStyle}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </TabItem>

            <TabItem Header="任务与执行">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid Grid.Column="0"
                              Style="{StaticResource DashboardDataGridStyle}"
                              ItemsSource="{Binding Tasks}"
                              SelectedItem="{Binding SelectedTask}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TaskId" Binding="{Binding TaskId}" ElementStyle="{StaticResource CellTextStyle}" Width="150"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" ElementStyle="{StaticResource CellTextStyle}" Width="110"/>
                            <DataGridTextColumn Header="Vehicle" Binding="{Binding AssignedVehicleId}" ElementStyle="{StaticResource CellTextStyle}" Width="110"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding SourceNodeId}" ElementStyle="{StaticResource CellTextStyle}" Width="100"/>
                            <DataGridTextColumn Header="Target" Binding="{Binding TargetNodeId}" ElementStyle="{StaticResource CellTextStyle}" Width="100"/>
                            <DataGridTextColumn Header="Current" Binding="{Binding CurrentNodeId}" ElementStyle="{StaticResource CellTextStyle}" Width="100"/>
                            <DataGridTextColumn Header="Progress" Binding="{Binding ProgressPercent}" ElementStyle="{StaticResource CellTextStyle}" Width="90"/>
                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" ElementStyle="{StaticResource CellTextStyle}" Width="90"/>
                            <DataGridTextColumn Header="CreatedAt" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" ElementStyle="{StaticResource CellTextStyle}" Width="150"/>
                            <DataGridTextColumn Header="Reason" Binding="{Binding FailureReason}" ElementStyle="{StaticResource CellTextStyle}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Column="1" Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0" Style="{StaticResource DashboardDataGridStyle}" ItemsSource="{Binding SelectedTaskExecutions}" Margin="0,0,0,6">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ExecutionId" Binding="{Binding ExecutionId}" ElementStyle="{StaticResource CellTextStyle}" Width="150"/>
                                <DataGridTextColumn Header="State" Binding="{Binding State}" ElementStyle="{StaticResource CellTextStyle}" Width="120"/>
                                <DataGridTextColumn Header="PlanId" Binding="{Binding PlanId}" ElementStyle="{StaticResource CellTextStyle}" Width="110"/>
                                <DataGridTextColumn Header="ReservationId" Binding="{Binding ReservationId}" ElementStyle="{StaticResource CellTextStyle}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Grid.Row="1" Style="{StaticResource DashboardDataGridStyle}" ItemsSource="{Binding SelectedTaskReservations}" Margin="0,6,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ReservationId" Binding="{Binding ReservationId}" ElementStyle="{StaticResource CellTextStyle}" Width="150"/>
                                <DataGridTextColumn Header="State" Binding="{Binding State}" ElementStyle="{StaticResource CellTextStyle}" Width="120"/>
                                <DataGridTextColumn Header="Window" Binding="{Binding CurrentWindow}" ElementStyle="{StaticResource CellTextStyle}" Width="90"/>
                                <DataGridTextColumn Header="UpdatedAt" Binding="{Binding UpdatedAt, StringFormat=HH:mm:ss}" ElementStyle="{StaticResource CellTextStyle}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="车辆">
                <DataGrid Margin="8" Style="{StaticResource DashboardDataGridStyle}" ItemsSource="{Binding Vehicles}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Detail" Width="78">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="详情"
                                            Width="56"
                                            Height="24"
                                            Command="{Binding DataContext.OpenVehicleWindowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="VehicleId" Binding="{Binding VehicleId}" ElementStyle="{StaticResource CellTextStyle}" Width="130"/>
                        <DataGridTextColumn Header="Code" Binding="{Binding VehicleCode}" ElementStyle="{StaticResource CellTextStyle}" Width="100"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" ElementStyle="{StaticResource CellTextStyle}" Width="120"/>
                        <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" ElementStyle="{StaticResource CellTextStyle}" Width="100"/>
                        <DataGridTextColumn Header="Adapter" Binding="{Binding AdapterType}" ElementStyle="{StaticResource CellTextStyle}" Width="110"/>
                        <DataGridTextColumn Header="State" Binding="{Binding State}" ElementStyle="{StaticResource CellTextStyle}" Width="100"/>
                        <DataGridCheckBoxColumn Header="Online" Binding="{Binding IsOnline}" Width="80"/>
                        <DataGridTextColumn Header="Battery" Binding="{Binding BatteryLevel}" ElementStyle="{StaticResource CellTextStyle}" Width="90"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" ElementStyle="{StaticResource CellTextStyle}" Width="140"/>
                        <DataGridTextColumn Header="Task" Binding="{Binding CurrentTaskId}" ElementStyle="{StaticResource CellTextStyle}" Width="130"/>
                        <DataGridCheckBoxColumn Header="Alarm" Binding="{Binding HasAlarm}" Width="80"/>
                        <DataGridTextColumn Header="AlarmCode" Binding="{Binding ActiveAlarmCode}" ElementStyle="{StaticResource StateCellTextStyle}" Width="110"/>
                        <DataGridTextColumn Header="AlarmMessage" Binding="{Binding ActiveAlarmMessage}" ElementStyle="{StaticResource StateCellTextStyle}" Width="220"/>
                        <DataGridTextColumn Header="ReportedAt" Binding="{Binding ReportedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" ElementStyle="{StaticResource CellTextStyle}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="交通资源">
                <DataGrid Margin="8" Style="{StaticResource DashboardDataGridStyle}" ItemsSource="{Binding TrafficResources}">
                    <DataGrid.Columns>
                            <DataGridTextColumn Header="ResourceType" Binding="{Binding ResourceType}" ElementStyle="{StaticResource CellTextStyle}" Width="110"/>
                            <DataGridTextColumn Header="ResourceId" Binding="{Binding ResourceId}" ElementStyle="{StaticResource CellTextStyle}" Width="130"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" ElementStyle="{StaticResource StateCellTextStyle}" Width="100"/>
                            <DataGridTextColumn Header="OccupiedByAgvId" Binding="{Binding OccupiedByAgvId}" ElementStyle="{StaticResource CellTextStyle}" Width="130"/>
                            <DataGridTextColumn Header="ReservedByAgvId" Binding="{Binding ReservedByAgvId}" ElementStyle="{StaticResource CellTextStyle}" Width="130"/>
                            <DataGridTextColumn Header="TaskId" Binding="{Binding TaskId}" ElementStyle="{StaticResource CellTextStyle}" Width="140"/>
                            <DataGridTextColumn Header="ReservationId" Binding="{Binding ReservationId}" ElementStyle="{StaticResource CellTextStyle}" Width="170"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" ElementStyle="{StaticResource CellTextStyle}" Width="220"/>
                        <DataGridTextColumn Header="ExpireAt" Binding="{Binding ExpireAt, StringFormat=yyyy-MM-dd HH:mm:ss}" ElementStyle="{StaticResource CellTextStyle}" Width="150"/>
                        <DataGridTextColumn Header="UpdatedAt" Binding="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" ElementStyle="{StaticResource CellTextStyle}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="路线预约">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" Style="{StaticResource DashboardDataGridStyle}" ItemsSource="{Binding RouteReservations}" SelectedItem="{Binding SelectedRouteReservation}" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ReservationId" Binding="{Binding ReservationId}" ElementStyle="{StaticResource CellTextStyle}" Width="170"/>
                            <DataGridTextColumn Header="TaskId" Binding="{Binding TaskId}" ElementStyle="{StaticResource CellTextStyle}" Width="140"/>
                            <DataGridTextColumn Header="VehicleId" Binding="{Binding VehicleId}" ElementStyle="{StaticResource CellTextStyle}" Width="120"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" ElementStyle="{StaticResource CellTextStyle}" Width="120"/>
                            <DataGridTextColumn Header="PlanId" Binding="{Binding PlanId}" ElementStyle="{StaticResource CellTextStyle}" Width="130"/>
                            <DataGridTextColumn Header="RollingWindowSize" Binding="{Binding RollingWindowSize}" ElementStyle="{StaticResource CellTextStyle}" Width="130"/>
                            <DataGridTextColumn Header="Segment count" Binding="{Binding SegmentCount}" ElementStyle="{StaticResource CellTextStyle}" Width="110"/>
                            <DataGridTextColumn Header="Window" Binding="{Binding CurrentWindow}" ElementStyle="{StaticResource CellTextStyle}" Width="90"/>
                            <DataGridTextColumn Header="UpdatedAt" Binding="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" ElementStyle="{StaticResource CellTextStyle}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid Grid.Row="1" Style="{StaticResource DashboardDataGridStyle}" ItemsSource="{Binding SelectedReservationSegments}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sequence" Binding="{Binding Sequence}" ElementStyle="{StaticResource CellTextStyle}" Width="90"/>
                            <DataGridTextColumn Header="EdgeId" Binding="{Binding EdgeId}" ElementStyle="{StaticResource CellTextStyle}" Width="130"/>
                            <DataGridTextColumn Header="FromNodeId" Binding="{Binding FromNodeId}" ElementStyle="{StaticResource CellTextStyle}" Width="130"/>
                            <DataGridTextColumn Header="ToNodeId" Binding="{Binding ToNodeId}" ElementStyle="{StaticResource CellTextStyle}" Width="130"/>
                            <DataGridCheckBoxColumn Header="IsLocked" Binding="{Binding IsLocked}" Width="90"/>
                            <DataGridCheckBoxColumn Header="IsReleased" Binding="{Binding IsReleased}" Width="90"/>
                            <DataGridTextColumn Header="TrafficReservationIds" Binding="{Binding TrafficReservationIds}" ElementStyle="{StaticResource CellTextStyle}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="演示场景">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="场景选择"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>
                            <ComboBox ItemsSource="{Binding ScenarioOptions}"
                                      SelectedItem="{Binding SelectedScenario}"
                                      DisplayMemberPath="Name"
                                      Height="32"
                                      Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding SelectedScenario.Description}"
                                       Foreground="#8FA8BF"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="当前会话"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,8"/>
                            <TextBlock Text="{Binding ScenarioRouteSummary}"
                                       Foreground="#D8E8F8"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding ScenarioTaskAId, StringFormat=A车任务：{0}}"
                                       Foreground="#8FA8BF"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ScenarioTaskBId, StringFormat=B车任务：{0}}"
                                       Foreground="#8FA8BF"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding ScenarioManualBlockResource, StringFormat=封路资源：{0}}"
                                       Foreground="#8FA8BF"
                                       TextWrapping="Wrap"/>
                            <CheckBox Content="人工封路生效"
                                      IsChecked="{Binding IsScenarioManualBlockActive, Mode=OneWay}"
                                      IsEnabled="False"
                                      Foreground="#D8E8F8"
                                      Margin="0,8,0,16"/>

                            <WrapPanel>
                                <Button Content="初始化场景"
                                        Command="{Binding InitializeScenarioCommand}"
                                        Width="104"
                                        Height="30"
                                        Margin="0,0,8,8"/>
                                <Button Content="启动车A"
                                        Command="{Binding StartVehicleACommand}"
                                        Width="104"
                                        Height="30"
                                        Margin="0,0,8,8"/>
                                <Button Content="启动车B"
                                        Command="{Binding StartVehicleBCommand}"
                                        Width="104"
                                        Height="30"
                                        Margin="0,0,8,8"/>
                                <Button Content="车A到达"
                                        Command="{Binding VehicleAArriveNextNodeCommand}"
                                        Width="104"
                                        Height="30"
                                        Margin="0,0,8,8"/>
                                <Button Content="车B重试"
                                        Command="{Binding VehicleBRetryWaitingTaskCommand}"
                                        Width="104"
                                        Height="30"
                                        Margin="0,0,8,8"/>
                                <Button Content="人工封路"
                                        Command="{Binding ManualBlockScenarioCommand}"
                                        Width="104"
                                        Height="30"
                                        Margin="0,0,8,8"/>
                                <Button Content="人工解封"
                                        Command="{Binding ManualUnblockScenarioCommand}"
                                        Width="104"
                                        Height="30"
                                        Margin="0,0,8,8"/>
                                <Button Content="重置场景"
                                        Command="{Binding ResetScenarioCommand}"
                                        Width="104"
                                        Height="30"
                                        Margin="0,0,8,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Column="1"
                              Style="{StaticResource DashboardDataGridStyle}"
                              ItemsSource="{Binding ScenarioLogs}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss.fff}" ElementStyle="{StaticResource CellTextStyle}" Width="120"/>
                            <DataGridTextColumn Header="步骤" Binding="{Binding Step}" ElementStyle="{StaticResource CellTextStyle}" Width="160"/>
                            <DataGridTextColumn Header="结果" Binding="{Binding Result}" ElementStyle="{StaticResource CellTextStyle}" Width="120"/>
                            <DataGridTextColumn Header="详情" Binding="{Binding Details}" ElementStyle="{StaticResource CellTextStyle}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Mock Simulation">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <WrapPanel Grid.Row="0" Grid.ColumnSpan="4" Margin="0,0,0,12">
                                <ComboBox ItemsSource="{Binding MockSimulationScenarioOptions}"
                                          SelectedItem="{Binding SelectedMockSimulationScenario}"
                                          DisplayMemberPath="Name"
                                          Width="220"
                                          Height="30"
                                          Margin="0,0,10,8"/>
                                <Button Content="LoadScenario"
                                        Command="{Binding LoadMockSimulationScenarioCommand}"
                                        Width="112"
                                        Height="30"
                                        Margin="0,0,10,8"/>
                                <Button Content="StartAll"
                                        Command="{Binding StartAllMockSimulationTasksCommand}"
                                        Width="86"
                                        Height="30"
                                        Margin="0,0,10,8"/>
                                <Button Content="Start selected vehicle/task"
                                        Command="{Binding StartSelectedMockSimulationTaskCommand}"
                                        Width="178"
                                        Height="30"
                                        Margin="0,0,10,8"/>
                                <Button Content="Step"
                                        Command="{Binding StepMockSimulationCommand}"
                                        Width="64"
                                        Height="30"
                                        Margin="0,0,10,8"/>
                                <Button Content="Run 10 ticks"
                                        Command="{Binding RunTenMockSimulationTicksCommand}"
                                        Width="104"
                                        Height="30"
                                        Margin="0,0,10,8"/>
                                <Button Content="Run until idle"
                                        Command="{Binding RunMockSimulationUntilIdleCommand}"
                                        Width="112"
                                        Height="30"
                                        Margin="0,0,10,8"/>
                                <Button Content="Stop auto run"
                                        Command="{Binding StopMockSimulationRunCommand}"
                                        Width="112"
                                        Height="30"
                                        Margin="0,0,10,8"/>
                                <Button Content="CancelTask"
                                        Command="{Binding CancelSelectedMockSimulationTaskCommand}"
                                        Width="104"
                                        Height="30"
                                        Margin="0,0,10,8"/>
                                <ComboBox ItemsSource="{Binding MockFaultPolicies}"
                                          SelectedItem="{Binding SelectedMockFaultPolicy}"
                                          Width="160"
                                          Height="30"
                                          Margin="0,0,10,8"/>
                                <Button Content="InjectFault"
                                        Command="{Binding InjectMockSimulationFaultCommand}"
                                        Width="104"
                                        Height="30"
                                        Margin="0,0,10,8"/>
                                <Button Content="Recover"
                                        Command="{Binding RecoverMockSimulationVehicleCommand}"
                                        Width="86"
                                        Height="30"
                                        Margin="0,0,10,8"/>
                            </WrapPanel>
                            <WrapPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,0,0,12">
                                <TextBox Text="{Binding MockMapEdgeId, UpdateSourceTrigger=PropertyChanged}"
                                         Width="140"
                                         Height="30"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,8,8"/>
                                <Button Content="Disable edge"
                                        Command="{Binding DisableMockMapEdgeCommand}"
                                        Width="104"
                                        Height="30"
                                        Margin="0,0,8,8"/>
                                <Button Content="Enable edge"
                                        Command="{Binding EnableMockMapEdgeCommand}"
                                        Width="96"
                                        Height="30"
                                        Margin="0,0,16,8"/>
                                <ComboBox ItemsSource="{Binding MockTrafficResourceTypes}"
                                          SelectedItem="{Binding SelectedMockTrafficResourceType}"
                                          Width="82"
                                          Height="30"
                                          Margin="0,0,8,8"/>
                                <TextBox Text="{Binding MockTrafficResourceId, UpdateSourceTrigger=PropertyChanged}"
                                         Width="140"
                                         Height="30"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,8,8"/>
                                <Button Content="Block"
                                        Command="{Binding BlockMockTrafficResourceCommand}"
                                        Width="72"
                                        Height="30"
                                        Margin="0,0,8,8"/>
                                <Button Content="Unblock"
                                        Command="{Binding UnblockMockTrafficResourceCommand}"
                                        Width="82"
                                        Height="30"
                                        Margin="0,0,16,8"/>
                                <CheckBox Content="ReplanOnLockedResource"
                                          IsChecked="{Binding MockReplanOnLockedResource}"
                                          Foreground="#D8E8F8"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,8"/>
                                <CheckBox Content="ReplanOnBlockedResource"
                                          IsChecked="{Binding MockReplanOnBlockedResource}"
                                          Foreground="#D8E8F8"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,8"/>
                                <CheckBox Content="PreferWaitingOverReplan"
                                          IsChecked="{Binding MockPreferWaitingOverReplan}"
                                          Foreground="#D8E8F8"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,8"/>
                                <TextBlock Text="MaxReplan"
                                           Foreground="#8FA8BF"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,8"/>
                                <TextBox Text="{Binding MockMaxReplanCount, UpdateSourceTrigger=PropertyChanged}"
                                         Width="44"
                                         Height="30"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,8,8"/>
                                <TextBlock Text="Wait(s)"
                                           Foreground="#8FA8BF"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,8"/>
                                <TextBox Text="{Binding MockWaitTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                         Width="52"
                                         Height="30"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,8,8"/>
                                <TextBlock Text="Retry(s)"
                                           Foreground="#8FA8BF"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,8"/>
                                <TextBox Text="{Binding MockRetryIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                                         Width="52"
                                         Height="30"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,8,8"/>
                                <TextBlock Text="MaxRetry"
                                           Foreground="#8FA8BF"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,8"/>
                                <TextBox Text="{Binding MockMaxRetryCount, UpdateSourceTrigger=PropertyChanged}"
                                         Width="44"
                                         Height="30"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,8,8"/>
                                <Button Content="Apply options"
                                        Command="{Binding ApplyMockSimulationOptionsCommand}"
                                        Width="112"
                                        Height="30"
                                        Margin="0,0,8,8"/>
                            </WrapPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="ScenarioId" Foreground="#8FA8BF" FontSize="12"/>
                                <TextBlock Text="{Binding MockSimulationScenarioId}" Foreground="#D8E8F8" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Text="Name" Foreground="#8FA8BF" FontSize="12"/>
                                <TextBlock Text="{Binding MockSimulationName}" Foreground="#D8E8F8" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="16,0,0,0">
                                <TextBlock Text="Tick" Foreground="#8FA8BF" FontSize="12"/>
                                <TextBlock Text="{Binding MockSimulationTick}" Foreground="#D8E8F8"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="3" Margin="16,0,0,0">
                                <TextBlock Text="Options" Foreground="#8FA8BF" FontSize="12"/>
                                <TextBlock Text="{Binding MockSimulationOptions}" Foreground="#D8E8F8" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,0,5,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DataGrid Grid.Row="0"
                                      Style="{StaticResource DashboardDataGridStyle}"
                                      ItemsSource="{Binding MockSimulationVehicles}"
                                      SelectedItem="{Binding SelectedMockSimulationVehicle}"
                                      Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="VehicleId" Binding="{Binding VehicleId}" ElementStyle="{StaticResource CellTextStyle}" Width="120"/>
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" ElementStyle="{StaticResource CellTextStyle}" Width="120"/>
                                    <DataGridTextColumn Header="CurrentNodeId" Binding="{Binding CurrentNodeId}" ElementStyle="{StaticResource CellTextStyle}" Width="130"/>
                                    <DataGridTextColumn Header="CurrentEdgeId" Binding="{Binding CurrentEdgeId}" ElementStyle="{StaticResource CellTextStyle}" Width="130"/>
                                    <DataGridTextColumn Header="CurrentTaskId" Binding="{Binding CurrentTaskId}" ElementStyle="{StaticResource CellTextStyle}" Width="150"/>
                                    <DataGridTextColumn Header="ReservationId" Binding="{Binding ReservationId}" ElementStyle="{StaticResource CellTextStyle}" Width="160"/>
                                    <DataGridTextColumn Header="PlanId" Binding="{Binding PlanId}" ElementStyle="{StaticResource CellTextStyle}" Width="130"/>
                                    <DataGridTextColumn Header="WaitRetryCount" Binding="{Binding WaitRetryCount}" ElementStyle="{StaticResource CellTextStyle}" Width="110"/>
                                    <DataGridTextColumn Header="ReplanCount" Binding="{Binding ReplanCount}" ElementStyle="{StaticResource CellTextStyle}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid Grid.Row="1"
                                      Style="{StaticResource DashboardDataGridStyle}"
                                      ItemsSource="{Binding MockSimulationTasks}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TaskId" Binding="{Binding TaskId}" ElementStyle="{StaticResource CellTextStyle}" Width="150"/>
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" ElementStyle="{StaticResource CellTextStyle}" Width="100"/>
                                    <DataGridTextColumn Header="VehicleId" Binding="{Binding VehicleId}" ElementStyle="{StaticResource CellTextStyle}" Width="120"/>
                                    <DataGridTextColumn Header="Source" Binding="{Binding SourceNodeId}" ElementStyle="{StaticResource CellTextStyle}" Width="100"/>
                                    <DataGridTextColumn Header="Target" Binding="{Binding TargetNodeId}" ElementStyle="{StaticResource CellTextStyle}" Width="100"/>
                                    <DataGridTextColumn Header="Progress" Binding="{Binding ProgressPercent}" ElementStyle="{StaticResource CellTextStyle}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                        <Grid Grid.Column="1" Margin="5,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Vehicle"
                                           Foreground="#8FA8BF"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding MockSimulationEventVehicleFilters}"
                                          SelectedItem="{Binding SelectedMockEventVehicleFilter}"
                                          Width="130"
                                          Height="28"
                                          Margin="0,0,12,0"/>
                                <TextBlock Text="EventType"
                                           Foreground="#8FA8BF"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding MockSimulationEventTypeFilters}"
                                          SelectedItem="{Binding SelectedMockEventTypeFilter}"
                                          Width="170"
                                          Height="28"/>
                            </WrapPanel>
                            <DataGrid Grid.Row="1"
                                      Style="{StaticResource DashboardDataGridStyle}"
                                      ItemsSource="{Binding MockSimulationEventTimelineView}"
                                      SelectedItem="{Binding SelectedMockSimulationEvent}"
                                      Margin="0,0,0,8">
                                <DataGrid.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Border Background="#102033"
                                                        BorderBrush="#1A2B3C"
                                                        BorderThickness="0,1,0,1"
                                                        Padding="8,4">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="#00BFFF"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </DataGrid.GroupStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tick" Binding="{Binding Tick}" ElementStyle="{StaticResource CellTextStyle}" Width="64"/>
                                    <DataGridTextColumn Header="EventType" Binding="{Binding EventType}" ElementStyle="{StaticResource CellTextStyle}" Width="140"/>
                                    <DataGridTextColumn Header="VehicleId" Binding="{Binding VehicleId}" ElementStyle="{StaticResource CellTextStyle}" Width="110"/>
                                    <DataGridTextColumn Header="TaskId" Binding="{Binding TaskId}" ElementStyle="{StaticResource CellTextStyle}" Width="140"/>
                                    <DataGridTextColumn Header="ResourceId" Binding="{Binding ResourceId}" ElementStyle="{StaticResource CellTextStyle}" Width="130"/>
                                    <DataGridTextColumn Header="OldReservationId" Binding="{Binding OldReservationId}" ElementStyle="{StaticResource CellTextStyle}" Width="150"/>
                                    <DataGridTextColumn Header="NewReservationId" Binding="{Binding NewReservationId}" ElementStyle="{StaticResource CellTextStyle}" Width="150"/>
                                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" ElementStyle="{StaticResource CellTextStyle}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding SelectedMockSimulationEvent.EventType, StringFormat=EventType: {0}}"
                                               Foreground="#D8E8F8"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding SelectedMockSimulationEvent.Tick, StringFormat=Tick: {0}}"
                                               Foreground="#8FA8BF"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="{Binding SelectedMockSimulationEvent.VehicleId, StringFormat=VehicleId: {0}}"
                                               Foreground="#8FA8BF"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding SelectedMockSimulationEvent.TaskId, StringFormat=TaskId: {0}}"
                                               Foreground="#8FA8BF"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Text="{Binding SelectedMockSimulationEvent.OldReservationId, StringFormat=OldReservationId: {0}}"
                                               Foreground="#8FA8BF"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="{Binding SelectedMockSimulationEvent.NewReservationId, StringFormat=NewReservationId: {0}}"
                                               Foreground="#8FA8BF"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBox Grid.Row="3"
                                             Grid.ColumnSpan="2"
                                             Text="{Binding SelectedMockSimulationEvent.Message}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="#08111E"
                                             Foreground="#D8E8F8"
                                             BorderBrush="#1A2B3C"
                                             Margin="0,8,0,0"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Okapi 协议">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" Style="{StaticResource DashboardDataGridStyle}" ItemsSource="{Binding OkapiProtocolRecords}" SelectedItem="{Binding SelectedOkapiRecord}" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss}" ElementStyle="{StaticResource CellTextStyle}" Width="150"/>
                            <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" ElementStyle="{StaticResource CellTextStyle}" Width="100"/>
                            <DataGridTextColumn Header="VehicleId" Binding="{Binding VehicleId}" ElementStyle="{StaticResource CellTextStyle}" Width="120"/>
                            <DataGridTextColumn Header="CommandType" Binding="{Binding CommandType}" ElementStyle="{StaticResource CellTextStyle}" Width="130"/>
                            <DataGridTextColumn Header="TaskId" Binding="{Binding TaskId}" ElementStyle="{StaticResource CellTextStyle}" Width="140"/>
                            <DataGridTextColumn Header="Url" Binding="{Binding Url}" ElementStyle="{StaticResource CellTextStyle}" Width="220"/>
                            <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" ElementStyle="{StaticResource StateCellTextStyle}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding SelectedOkapiRecord.RequestBody}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#08111E"
                                 Foreground="#D8E8F8"
                                 BorderBrush="#1A2B3C"
                                 Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SelectedOkapiRecord.ResponseBody}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#08111E"
                                 Foreground="#D8E8F8"
                                 BorderBrush="#1A2B3C"
                                 Margin="6,0,0,0"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
