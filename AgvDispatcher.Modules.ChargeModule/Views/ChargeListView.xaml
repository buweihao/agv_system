<UserControl x:Class="AgvDispatcher.Modules.ChargeModule.Views.ChargeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:core="clr-namespace:AgvDispatcher.Core.Enums;assembly=AgvDispatcher.Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="Transparent">
    
    <Border Background="#0F1A2A" BorderBrush="#1F3A60" Margin="10" BorderThickness="1" CornerRadius="6" Padding="15">
        <Grid>
            <DataGrid ItemsSource="{Binding StationList}" AutoGenerateColumns="False" Background="Transparent" 
                      RowBackground="Transparent" AlternatingRowBackground="#1A2B3C" 
                      Foreground="White" GridLinesVisibility="None" BorderThickness="0" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#112233"/>
                        <Setter Property="Foreground" Value="#00BFFF"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#1F3A60"/>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#1F3A60"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A3B4C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1F3A60"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="桩位ID" Binding="{Binding Id}" Width="*"/>
                    <DataGridTemplateColumn Header="状态" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding State}" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static core:RobotState.Running}">
                                                    <Setter Property="Foreground" Value="#00FF7F"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static core:RobotState.Idle}">
                                                    <Setter Property="Foreground" Value="#FFD700"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static core:RobotState.Fault}">
                                                    <Setter Property="Foreground" Value="#FF4500"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static core:RobotState.Offline}">
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="关联AGV" Binding="{Binding LinkedAgv}" Width="*"/>
                    <DataGridTemplateColumn Header="电量" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding BatteryLevel}" Height="10" 
                                                 Background="#1F3A60" Foreground="#00FF7F" BorderThickness="0" Margin="0,0,30,0"/>
                                    <TextBlock Text="{Binding BatteryLevel, StringFormat={}{0}%}" Foreground="White" FontSize="10" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="充电模式" Binding="{Binding ChargeMode}" Width="*"/>
                    <DataGridTextColumn Header="充电功率" Binding="{Binding ChargePower}" Width="*"/>
                    <DataGridTextColumn Header="已充时长" Binding="{Binding ChargedTime}" Width="*"/>
                    <DataGridTextColumn Header="预计完成" Binding="{Binding EstimatedCompletion}" Width="*"/>
                    <DataGridTemplateColumn Header="操作" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="详情" Background="#00BFFF" Foreground="White" BorderThickness="0" Padding="8,4" Margin="0,0,5,0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="2"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="取消排队" Background="Gray" Foreground="White" BorderThickness="0" Padding="8,4" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="2"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
