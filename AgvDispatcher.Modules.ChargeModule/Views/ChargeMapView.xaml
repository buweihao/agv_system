<UserControl x:Class="AgvDispatcher.Modules.ChargeModule.Views.ChargeMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#050B14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Legend -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Ellipse Width="12" Height="12" Fill="#00FF7F" Margin="0,0,5,0"/><TextBlock Text="充电中" Foreground="White" Margin="0,0,15,0"/>
            <Ellipse Width="12" Height="12" Fill="#FFD700" Margin="0,0,5,0"/><TextBlock Text="等待充电" Foreground="White" Margin="0,0,15,0"/>
            <Ellipse Width="12" Height="12" Fill="#00BFFF" Margin="0,0,5,0"/><TextBlock Text="空闲" Foreground="White" Margin="0,0,15,0"/>
            <Ellipse Width="12" Height="12" Fill="#FF4500" Margin="0,0,5,0"/><TextBlock Text="故障" Foreground="White" Margin="0,0,15,0"/>
            <Ellipse Width="12" Height="12" Fill="Gray" Margin="0,0,5,0"/><TextBlock Text="离线" Foreground="White"/>
        </StackPanel>
        
        <!-- Canvas Map Image -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <Image Source="pack://application:,,,/AgvDispatcher.Modules.ChargeModule;component/Images/Charge_bg.png" Stretch="Uniform" />
        </Grid>
    </Grid>
</UserControl>
