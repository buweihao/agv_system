<UserControl x:Class="AgvDispatcher.Modules.MapModule.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="#050B14">
    <UserControl.Resources>
        <Style x:Key="MapToggleStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" BorderBrush="#1F3A60" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E90FF"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Foreground" Value="LightGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        
        <!-- 工具栏 -->
        <Grid Grid.Row="0" Background="#0A111E">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="▶ 地图模式" Foreground="#00BFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                
                <RadioButton x:Name="Rb2D" Content="2D" GroupName="MapMode" IsChecked="True" Style="{StaticResource MapToggleStyle}" Padding="20,5" Margin="0,0,10,0"/>
                <RadioButton x:Name="Rb3D" Content="3D" GroupName="MapMode" Style="{StaticResource MapToggleStyle}" Padding="20,5"/>
            </StackPanel>
        </Grid>
        
        <!-- 核心地图渲染区 -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <!-- 2D View -->
            <Border x:Name="View2D">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=Rb3D}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            <Border.Background>
                <!-- 极暗蓝黑色底与暗蓝色正方形网格 -->
                <DrawingBrush TileMode="Tile" Viewport="0,0,30,30" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="0,0" EndPoint="30,0" />
                                    <LineGeometry StartPoint="0,0" EndPoint="0,30" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                            <GeometryDrawing.Pen>
                                <Pen Thickness="1" Brush="#112340" />
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>

            <Viewbox Stretch="Uniform">
                <Canvas x:Name="MapCanvas" Width="860" Height="580">
                <!-- ================= 路径虚线规划 ================= -->
                <!-- Outer Perimeter -->
                <Polyline Points="60,60 680,60 680,500 60,500 60,60" Stroke="#00FF7F" StrokeThickness="2" StrokeDashArray="4 4" Opacity="0.7"/>
                <Polyline Points="60,280 680,280" Stroke="#00FF7F" StrokeThickness="2" StrokeDashArray="4 4" Opacity="0.7"/>
                <Polyline Points="260,60 260,500" Stroke="#00FF7F" StrokeThickness="2" StrokeDashArray="4 4" Opacity="0.7"/>
                <Polyline Points="460,60 460,500" Stroke="#00FF7F" StrokeThickness="2" StrokeDashArray="4 4" Opacity="0.7"/>

                <!-- Far right path for 05 -->
                <Polyline Points="680,60 760,60 760,500 680,500" Stroke="#00FF7F" StrokeThickness="2" StrokeDashArray="4 4" Opacity="0.7"/>

                <!-- ================= 区域标签 ================= -->
                <Border Canvas.Left="60" Canvas.Top="70" Canvas.ZIndex="100" Background="#1E3A5F" CornerRadius="4" Padding="6,4">
                    <TextBlock Text="01" Foreground="White" FontWeight="Bold" FontSize="14"/>
                </Border>
                <Border Canvas.Left="300" Canvas.Top="100" Canvas.ZIndex="100" Background="#1E3A5F" CornerRadius="4" Padding="6,4">
                    <TextBlock Text="02" Foreground="White" FontWeight="Bold" FontSize="14"/>
                </Border>
                <Border Canvas.Left="480" Canvas.Top="380" Canvas.ZIndex="100" Background="#1E3A5F" CornerRadius="4" Padding="6,4">
                    <TextBlock Text="03" Foreground="White" FontWeight="Bold" FontSize="14"/>
                </Border>
                <Border Canvas.Left="480" Canvas.Top="180" Canvas.ZIndex="100" Background="#1E3A5F" CornerRadius="4" Padding="6,4">
                    <TextBlock Text="04" Foreground="White" FontWeight="Bold" FontSize="14"/>
                </Border>
                <Border Canvas.Left="780" Canvas.Top="180" Canvas.ZIndex="100" Background="#1E3A5F" CornerRadius="4" Padding="6,4">
                    <TextBlock Text="05" Foreground="White" FontWeight="Bold" FontSize="14"/>
                </Border>

                <!-- ================= 静态货架区域 ================= -->
                <!-- Block 1 (Top Left) -->
                <Border Canvas.Left="90" Canvas.Top="90" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>
                <Border Canvas.Left="130" Canvas.Top="90" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>
                <Border Canvas.Left="180" Canvas.Top="90" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>
                <Border Canvas.Left="220" Canvas.Top="90" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>

                <!-- Block 2 (Top Mid) -->
                <Border Canvas.Left="290" Canvas.Top="90" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>
                <Border Canvas.Left="330" Canvas.Top="90" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>
                <Border Canvas.Left="380" Canvas.Top="90" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>
                <Border Canvas.Left="420" Canvas.Top="90" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>

                <!-- Block 3 (Top Right) -->
                <Border Canvas.Left="490" Canvas.Top="90" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>
                <Border Canvas.Left="530" Canvas.Top="90" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>
                <Border Canvas.Left="580" Canvas.Top="90" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>
                <Border Canvas.Left="620" Canvas.Top="90" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>

                <!-- Block 4 (Bot Left) -->
                <Border Canvas.Left="90" Canvas.Top="310" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>
                <Border Canvas.Left="130" Canvas.Top="310" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>
                <Border Canvas.Left="180" Canvas.Top="310" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>
                <Border Canvas.Left="220" Canvas.Top="310" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>

                <!-- Block 5 (Bot Mid) -->
                <Border Canvas.Left="290" Canvas.Top="310" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>
                <Border Canvas.Left="330" Canvas.Top="310" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>
                <Border Canvas.Left="380" Canvas.Top="310" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>
                <Border Canvas.Left="420" Canvas.Top="310" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>

                <!-- Block 6 (Bot Right) -->
                <Border Canvas.Left="490" Canvas.Top="310" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>
                <Border Canvas.Left="530" Canvas.Top="310" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>
                <Border Canvas.Left="580" Canvas.Top="310" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>
                <Border Canvas.Left="620" Canvas.Top="310" Width="25" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2"/>

                <!-- ================= AGV 小车滑块 ================= -->
                <!-- AGV 001 (Top Left, Green) -->
                <Grid Canvas.Left="150" Canvas.Top="52">
                    <Border Background="#2E8B57" CornerRadius="4" Padding="6,2" Margin="0,-24,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="001" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Border Width="30" Height="16" Background="#32CD32" CornerRadius="8" BorderBrush="White" BorderThickness="1">
                        <TextBlock Text="🔋" FontSize="10" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- AGV 002 (Mid Right, Cyan) -->
                <Grid Canvas.Left="480" Canvas.Top="272">
                    <Border Background="#008B8B" CornerRadius="4" Padding="6,2" Margin="0,-24,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="002" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Border Width="30" Height="16" Background="#00FFFF" CornerRadius="8" BorderBrush="White" BorderThickness="1">
                        <TextBlock Text="⚡" FontSize="10" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- AGV 003 (Top Left Rack, Yellow) -->
                <!-- Path for 003 -->
                <Polyline Points="167,280 167,180" Stroke="#FFD700" StrokeThickness="2" StrokeDashArray="4 4"/>
                <Grid Canvas.Left="152" Canvas.Top="180">
                    <Border Background="#DAA520" CornerRadius="4" Padding="6,2" Margin="0,-24,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="003" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Border Width="30" Height="16" Background="#FFD700" CornerRadius="8" BorderBrush="White" BorderThickness="1">
                        <TextBlock Text="🔋" FontSize="10" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- AGV 005 (Top Right, Green) -->
                <Grid Canvas.Left="600" Canvas.Top="52">
                    <Border Background="#2E8B57" CornerRadius="4" Padding="6,2" Margin="0,-24,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="005" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Border Width="30" Height="16" Background="#32CD32" CornerRadius="8" BorderBrush="White" BorderThickness="1">
                        <TextBlock Text="🔋" FontSize="10" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- AGV 006 (Bot Left, Yellow) -->
                <Grid Canvas.Left="152" Canvas.Top="492">
                    <Border Background="#DAA520" CornerRadius="4" Padding="6,2" Margin="0,-24,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="006" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Border Width="30" Height="16" Background="#FFD700" CornerRadius="8" BorderBrush="White" BorderThickness="1">
                        <TextBlock Text="🔋" FontSize="10" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- AGV 007 (Bot Right, Green) -->
                <Grid Canvas.Left="600" Canvas.Top="492">
                    <Border Background="#2E8B57" CornerRadius="4" Padding="6,2" Margin="0,-24,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="007" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Border Width="30" Height="16" Background="#32CD32" CornerRadius="8" BorderBrush="White" BorderThickness="1">
                        <TextBlock Text="🔋" FontSize="10" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- AGV 008 (Top Right Rack, Red) -->
                <!-- Path for 008 -->
                <Polyline Points="567,280 567,200 600,200" Stroke="#FF4500" StrokeThickness="2" StrokeDashArray="4 4"/>
                <Grid Canvas.Left="552" Canvas.Top="200">
                    <Border Background="#8B0000" CornerRadius="4" Padding="6,2" Margin="0,-24,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="008" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Border Width="30" Height="16" Background="#FF4500" CornerRadius="8" BorderBrush="White" BorderThickness="1">
                        <TextBlock Text="🔋" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="⚠️" Foreground="Red" FontSize="16" Margin="25,-10,0,0" />
                </Grid>
                
                </Canvas>
            </Viewbox>
            </Border>

            <!-- 3D Image -->
            <Image x:Name="View3D" Source="pack://application:,,,/AgvDispatcher.Modules.MapModule;component/Images/main_bg.png" Stretch="Uniform">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=Rb3D}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </Grid>

        <!-- 图例 Legend -->
        <Grid Grid.Row="2" Background="#0A111E">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- 状态图例 -->
                <Ellipse Width="10" Height="10" Fill="#00FF7F" Margin="10,0,5,0"/><TextBlock Text="运行中" Foreground="LightGray" FontSize="12" VerticalAlignment="Center"/>
                <Ellipse Width="10" Height="10" Fill="#00BFFF" Margin="20,0,5,0"/><TextBlock Text="空闲" Foreground="LightGray" FontSize="12" VerticalAlignment="Center"/>
                <Ellipse Width="10" Height="10" Fill="#FFD700" Margin="20,0,5,0"/><TextBlock Text="执行任务" Foreground="LightGray" FontSize="12" VerticalAlignment="Center"/>
                <Ellipse Width="10" Height="10" Fill="#9370DB" Margin="20,0,5,0"/><TextBlock Text="充电中" Foreground="LightGray" FontSize="12" VerticalAlignment="Center"/>
                <Ellipse Width="10" Height="10" Fill="#FF4500" Margin="20,0,5,0"/><TextBlock Text="故障" Foreground="LightGray" FontSize="12" VerticalAlignment="Center"/>
                <Ellipse Width="10" Height="10" Fill="#D3D3D3" Margin="20,0,5,0"/><TextBlock Text="离线" Foreground="LightGray" FontSize="12" VerticalAlignment="Center"/>
                
                <!-- 路径图例 -->
                <Line X1="0" Y1="0" X2="24" Y2="0" Stroke="#00FF7F" StrokeDashArray="4 2" StrokeThickness="2" VerticalAlignment="Center" Margin="40,0,5,0"/><TextBlock Text="运行路径" Foreground="LightGray" FontSize="12" VerticalAlignment="Center"/>
                <Line X1="0" Y1="0" X2="24" Y2="0" Stroke="#FFD700" StrokeDashArray="4 2" StrokeThickness="2" VerticalAlignment="Center" Margin="20,0,5,0"/><TextBlock Text="任务路径" Foreground="LightGray" FontSize="12" VerticalAlignment="Center"/>
                <Line X1="0" Y1="0" X2="24" Y2="0" Stroke="#FF4500" StrokeDashArray="4 2" StrokeThickness="2" VerticalAlignment="Center" Margin="20,0,5,0"/><TextBlock Text="拥堵路段" Foreground="LightGray" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
