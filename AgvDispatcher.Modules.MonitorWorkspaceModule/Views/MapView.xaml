<UserControl x:Class="AgvDispatcher.Modules.MonitorWorkspaceModule.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="#050B14">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="MapToggleStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" BorderBrush="#1F3A60" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E90FF"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Foreground" Value="LightGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#0A111E">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="■ 地图模式" Foreground="#00BFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <RadioButton x:Name="Rb2D" Content="2D" GroupName="MapMode" IsChecked="True" Style="{StaticResource MapToggleStyle}" Padding="20,5" Margin="0,0,10,0"/>
                <RadioButton x:Name="Rb3D" Content="3D" GroupName="MapMode" Style="{StaticResource MapToggleStyle}" Padding="20,5"/>
            </StackPanel>

            <TextBlock Grid.Column="2"
                       Text="{Binding PathSummary}"
                       Foreground="#8FB8D8"
                       FontSize="13"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <Ellipse Width="9" Height="9" Fill="#FFD700" Margin="0,0,6,0"/>
                <TextBlock Text="当前规划路径" Foreground="LightGray" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ClipToBounds="True">
            <Border x:Name="View2D">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=Rb3D}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,30,30" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="30,0" />
                                        <LineGeometry StartPoint="0,0" EndPoint="0,30" />
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                                <GeometryDrawing.Pen>
                                    <Pen Thickness="1" Brush="#112340" />
                                </GeometryDrawing.Pen>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>

                <Grid Background="Transparent" ClipToBounds="True"
                      MouseWheel="MapContainer_MouseWheel"
                      MouseRightButtonDown="MapContainer_MouseRightButtonDown"
                      MouseRightButtonUp="MapContainer_MouseRightButtonUp"
                      MouseMove="MapContainer_MouseMove">
                    <Viewbox Stretch="Uniform" RenderTransformOrigin="0,0">
                        <Viewbox.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="MapScaleTransform" />
                                <TranslateTransform x:Name="MapTranslateTransform" />
                            </TransformGroup>
                        </Viewbox.RenderTransform>
                        <Canvas Width="860" Height="580" ClipToBounds="False">
                        <Border Canvas.Left="90" Canvas.Top="90" Width="160" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2" Opacity="0.9"/>
                        <Border Canvas.Left="290" Canvas.Top="90" Width="160" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2" Opacity="0.9"/>
                        <Border Canvas.Left="490" Canvas.Top="90" Width="160" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2" Opacity="0.9"/>
                        <Border Canvas.Left="90" Canvas.Top="310" Width="160" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2" Opacity="0.9"/>
                        <Border Canvas.Left="290" Canvas.Top="310" Width="160" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2" Opacity="0.9"/>
                        <Border Canvas.Left="490" Canvas.Top="310" Width="160" Height="160" Background="#15253A" BorderBrush="#254060" BorderThickness="1" CornerRadius="2" Opacity="0.9"/>

                        <ItemsControl ItemsSource="{Binding Edges}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Line X1="{Binding X1}"
                                          Y1="{Binding Y1}"
                                          X2="{Binding X2}"
                                          Y2="{Binding Y2}"
                                          Stroke="{Binding Stroke}"
                                          StrokeThickness="{Binding StrokeThickness}"
                                          StrokeDashArray="5 5"
                                          Opacity="{Binding Opacity}"
                                          Cursor="Hand">
                                        <Line.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.MapItemClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </Line.InputBindings>
                                    </Line>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding PlannedEdges}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Line X1="{Binding X1}"
                                          Y1="{Binding Y1}"
                                          X2="{Binding X2}"
                                          Y2="{Binding Y2}"
                                          Stroke="{Binding Stroke}"
                                          StrokeThickness="{Binding StrokeThickness}"
                                          Opacity="{Binding Opacity}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding PreviewEdges}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Line X1="{Binding X1}"
                                          Y1="{Binding Y1}"
                                          X2="{Binding X2}"
                                          Y2="{Binding Y2}"
                                          Stroke="{Binding Stroke}"
                                          StrokeThickness="{Binding StrokeThickness}"
                                          Opacity="{Binding Opacity}"
                                          IsHitTestVisible="False"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding EdgeArrows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Polyline Points="{Binding PointsText}"
                                              Stroke="{Binding Stroke}"
                                              StrokeThickness="{Binding StrokeThickness}"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Opacity="{Binding Opacity}"
                                              IsHitTestVisible="False"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Nodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding CanvasTop}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="18"
                                             Height="18"
                                             Fill="{Binding Fill}"
                                             Stroke="{Binding Stroke}"
                                             StrokeThickness="{Binding StrokeThickness}"
                                             Opacity="{Binding Opacity}"
                                             Cursor="Hand">
                                        <Ellipse.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.MapItemClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </Ellipse.InputBindings>
                                        <Ellipse.ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding NodeId}"/>
                                                <TextBlock Text="{Binding NodeType}"/>
                                            </StackPanel>
                                        </Ellipse.ToolTip>
                                    </Ellipse>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Nodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding LabelLeft}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding LabelTop}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E3A5F" CornerRadius="4" Padding="6,3" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.MapItemClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <TextBlock Text="{Binding NodeCode}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Vehicles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding CanvasTop}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Cursor="Hand">
                                        <StackPanel.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.MapItemClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel.InputBindings>
                                        <Border Background="#0A111E" BorderBrush="{Binding Fill}" BorderThickness="1" CornerRadius="4" Padding="5,2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding VehicleId}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <Border Width="30" Height="16" Background="{Binding Fill}" CornerRadius="8" BorderBrush="White" BorderThickness="1">
                                            <TextBlock Text="AGV" FontSize="8" Foreground="#05111F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </Viewbox>

                <!-- Detail Panel overlay (collapsible) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20" Width="220" Background="#1A2536" BorderBrush="#2D5D88" BorderThickness="1" CornerRadius="4" Padding="15,10">
                    <StackPanel>
                        <ToggleButton x:Name="DetailToggle" IsChecked="False" Cursor="Hand" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DetailTitle}" Foreground="#00BFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="Chevron" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" Foreground="#8EA8C3" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <TextBlock Text="{Binding DetailContent}" Foreground="#DCEFFF" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,10,0,0"
                                   Visibility="{Binding IsChecked, ElementName=DetailToggle, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Path Planning Preview overlay (collapsible) -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20" Width="240" Background="#1A2536" BorderBrush="#2D5D88" BorderThickness="1" CornerRadius="4" Padding="15,10">
                    <StackPanel>
                        <ToggleButton x:Name="PreviewToggle" IsChecked="False" Cursor="Hand" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="路径规划预览" Foreground="#00E5FF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="Chevron2" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" Foreground="#8EA8C3" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="Chevron2" Property="Text" Value="&#xE70E;"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding IsChecked, ElementName=PreviewToggle, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="起点" Foreground="#8EA8C3" FontSize="12" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding Nodes}"
                                      SelectedItem="{Binding PreviewStartNode, Mode=TwoWay}"
                                      DisplayMemberPath="NodeCode"
                                      Margin="0,0,0,8"/>

                            <TextBlock Text="终点" Foreground="#8EA8C3" FontSize="12" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding Nodes}"
                                      SelectedItem="{Binding PreviewEndNode, Mode=TwoWay}"
                                      DisplayMemberPath="NodeCode"
                                      Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="预览路径"
                                        Command="{Binding PreviewPathCommand}"
                                        Background="#1E90FF" Foreground="White" BorderThickness="0"
                                        Padding="12,4" Cursor="Hand" Margin="0,0,8,0"/>
                                <Button Content="清除"
                                        Command="{Binding ClearPreviewCommand}"
                                        Background="#2A3B52" Foreground="#DCEFFF" BorderThickness="0"
                                        Padding="12,4" Cursor="Hand"/>
                            </StackPanel>

                            <TextBlock Text="{Binding PreviewSummary}"
                                       Foreground="#00E5FF" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                </Grid>
            </Border>

            <Image x:Name="View3D" Source="pack://application:,,,/AgvDispatcher.Modules.MonitorWorkspaceModule;component/Images/main_bg.png" Stretch="Uniform">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=Rb3D}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </Grid>

        <!-- Legend -->
        <Border Grid.Row="2" Background="#0A111E" Padding="20,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="图例：" Foreground="#8EA8C3" FontWeight="Bold" Margin="0,0,10,0"/>
                <Ellipse Width="10" Height="10" Fill="#00BFFF" Margin="0,0,5,0"/><TextBlock Text="待机点" Foreground="#8EA8C3" Margin="0,0,15,0"/>
                <Ellipse Width="10" Height="10" Fill="#32CD32" Margin="0,0,5,0"/><TextBlock Text="充电桩" Foreground="#8EA8C3" Margin="0,0,15,0"/>
                <Ellipse Width="10" Height="10" Fill="#FFA500" Margin="0,0,5,0"/><TextBlock Text="工作点" Foreground="#8EA8C3" Margin="0,0,15,0"/>
                <Line X1="0" Y1="0" X2="20" Y2="0" Stroke="#1E90FF" StrokeThickness="2" Margin="0,0,5,0"/><TextBlock Text="路径" Foreground="#8EA8C3" Margin="0,0,15,0"/>
                <Line X1="0" Y1="0" X2="20" Y2="0" Stroke="#00E5FF" StrokeThickness="3" Margin="0,0,5,0"/><TextBlock Text="预览路径" Foreground="#8EA8C3" Margin="0,0,15,0"/>
                <Line X1="0" Y1="0" X2="20" Y2="0" Stroke="#FFA500" StrokeThickness="2" Margin="0,0,5,0"/><TextBlock Text="锁定边" Foreground="#8EA8C3" Margin="0,0,15,0"/>
                <Line X1="0" Y1="0" X2="20" Y2="0" Stroke="#FF4500" StrokeThickness="2" Margin="0,0,5,0"/><TextBlock Text="禁用/封闭边" Foreground="#8EA8C3" Margin="0,0,15,0"/>
                <Polyline Points="0,0 6,4 0,8" Stroke="#00FF7F" StrokeThickness="2" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="方向" Foreground="#8EA8C3" Margin="0,0,15,0"/>
                <Ellipse Width="10" Height="10" Fill="#556070" Margin="0,0,5,0"/><TextBlock Text="禁用节点" Foreground="#8EA8C3" Margin="0,0,15,0"/>
                <Border Width="16" Height="10" Background="#FF4500" CornerRadius="4" Margin="0,0,5,0"/><TextBlock Text="AGV(异常)" Foreground="#8EA8C3"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
