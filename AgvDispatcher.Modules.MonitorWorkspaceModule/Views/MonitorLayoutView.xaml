<UserControl x:Class="AgvDispatcher.Modules.MonitorWorkspaceModule.Views.MonitorLayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:local="clr-namespace:AgvDispatcher.Modules.MonitorWorkspaceModule.Views"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#112233" Margin="10">
            <local:LeftPanelView />
        </Grid>

        <Grid Grid.Column="1" Margin="0,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="250" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#1A2B3C" Margin="0,0,0,10">
                <local:MapView />
            </Grid>

            <Grid Grid.Row="1" Background="#0F1A24">
                <local:RobotListView />
            </Grid>
        </Grid>

        <Grid Grid.Column="2" Background="#112233" Margin="0,10,10,10">
            <local:RightPanelView />
        </Grid>
    </Grid>
</UserControl>
