<UserControl x:Class="AgvDispatcher.Modules.MonitorWorkspaceModule.Views.RightPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="#0A111E">
    <UserControl.Resources>
        <!-- 鍗＄墖鏍峰紡 -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#1F3A60"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="#0F1A2A"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00BFFF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. 瀹炴椂鏁堢巼 -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="■ 实时效率" Style="{StaticResource TitleTextStyle}"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Grid Width="110" Height="110" Margin="5,10,15,10">
                        <Ellipse Stroke="#1F3A60" StrokeThickness="14" Width="110" Height="110"/>
                        <Ellipse Stroke="#00FF7F" StrokeThickness="14" Width="110" Height="110" StrokeDashArray="27 3" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TaskCompletionRate, StringFormat={}{0}%}" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="完成率" Foreground="LightGray" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 0 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="今日完成任务" Foreground="LightGray" FontSize="12" VerticalAlignment="Center" Margin="0,8,5,8"/>
                        <Viewbox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" StretchDirection="DownOnly" MaxHeight="24">
                            <TextBlock Text="{Binding TodayCompletedTasks, Mode=OneWay}" Foreground="#00BFFF" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Viewbox>

                        <!-- Row 1 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="今日行驶距离" Foreground="LightGray" FontSize="12" VerticalAlignment="Center" Margin="0,8,5,8"/>
                        <Viewbox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" StretchDirection="DownOnly" MaxHeight="24">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TodayDistance, Mode=OneWay}" Foreground="#00BFFF" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text=" km" Foreground="LightGray" FontSize="12" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                            </StackPanel>
                        </Viewbox>

                        <!-- Row 2 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="平均速度" Foreground="LightGray" FontSize="12" VerticalAlignment="Center" Margin="0,8,5,8"/>
                        <Viewbox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" StretchDirection="DownOnly" MaxHeight="24">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AvgSpeed, Mode=OneWay}" Foreground="#00BFFF" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text=" m/s" Foreground="LightGray" FontSize="12" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                            </StackPanel>
                        </Viewbox>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. 瀹炴椂鍛婅 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="■ 实时告警" Style="{StaticResource TitleTextStyle}"/>
                    <TextBlock Text="更多 &gt;" Foreground="Gray" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="12" Cursor="Hand" Margin="0,2,10,0"/>
                </Grid>
                
                <ItemsControl Grid.Row="1" ItemsSource="{Binding RealtimeAlarms}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#1F3A60" BorderThickness="0,0,0,1" Margin="5,8,5,8" Padding="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- 鍛婅鍥炬爣 -->
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" BorderBrush="{Binding SeverityColor}" BorderThickness="2" Background="#11000000" Margin="0,0,15,0">
                                        <TextBlock Text="!" Foreground="{Binding SeverityColor}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                    </Border>
                                    
                                    <!-- 璁惧缂栧彿 -->
                                    <TextBlock Grid.Column="1" Text="{Binding Device}" Foreground="LightGray" FontSize="14" VerticalAlignment="Center" Margin="0,0,30,0"/>
                                    
                                    <!-- 鍛婅淇℃伅 -->
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                    
                                    <!-- 鍛婅鏃堕棿 -->
                                    <TextBlock Grid.Column="3" Text="{Binding Time}" Foreground="Gray" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- 3. 璁惧鍋ュ悍搴?-->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="设备健康度" Style="{StaticResource TitleTextStyle}"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Grid Width="120" Height="120" Margin="20,10,30,10">
                        <Ellipse Stroke="#1F3A60" StrokeThickness="16" Width="120" Height="120"/>
                        <Ellipse Stroke="#32CD32" StrokeThickness="16" Width="120" Height="120" StrokeDashArray="29 1" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding HealthScore, StringFormat={}{0}%}" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="健康度" Foreground="LightGray" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <Ellipse Width="8" Height="8" Fill="#32CD32" Margin="0,0,10,0"/>
                            <TextBlock Text="健康设备" Foreground="LightGray" FontSize="12" Width="60"/>
                            <TextBlock Text="{Binding HealthyDeviceCount}" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <Ellipse Width="8" Height="8" Fill="#FF4500" Margin="0,0,10,0"/>
                            <TextBlock Text="异常设备" Foreground="LightGray" FontSize="12" Width="60"/>
                            <TextBlock Text="{Binding AbnormalDeviceCount}" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <Ellipse Width="8" Height="8" Fill="Gray" Margin="0,0,10,0"/>
                            <TextBlock Text="离线设备" Foreground="LightGray" FontSize="12" Width="60"/>
                            <TextBlock Text="{Binding OfflineDeviceCount}" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 4. 鐜鐩戞帶 -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="■ 环境监控" Style="{StaticResource TitleTextStyle}"/>
                <UniformGrid Grid.Row="1" Columns="3">
                    <StackPanel HorizontalAlignment="Center" Margin="5">
                        <TextBlock Text="温度" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Margin="0,5,0,0">
                            <Run Text="{Binding Temperature, Mode=OneWay}" Foreground="#00FF7F" FontSize="18" FontWeight="Bold"/>
                            <Run Text=" ℃" Foreground="LightGray" FontSize="12"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" Margin="5">
                        <TextBlock Text="湿度" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Margin="0,5,0,0">
                            <Run Text="{Binding Humidity, Mode=OneWay}" Foreground="#00BFFF" FontSize="18" FontWeight="Bold"/>
                            <Run Text=" %" Foreground="LightGray" FontSize="12"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" Margin="5">
                        <TextBlock Text="信号强度" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SignalStrength, Mode=OneWay}" Foreground="#FFD700" FontSize="18" FontWeight="Bold" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
