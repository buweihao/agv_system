<UserControl x:Class="AgvDispatcher.Modules.SignalModule.Views.SignalWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:core="clr-namespace:AgvDispatcher.Core.Constants;assembly=AgvDispatcher.Core"
             xmlns:local="clr-namespace:AgvDispatcher.Modules.SignalModule.Views"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <Style x:Key="NavTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,0,0,6"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#00BFFF"/>
                    <Setter Property="BorderBrush" Value="#00BFFF"/>
                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧列 -->
        <Grid Grid.Column="0" Background="#112233" Margin="10">
            <local:SignalLeftPanelView />
        </Grid>

        <!-- 中间列 -->
        <Grid Grid.Column="1" Margin="0,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15" HorizontalAlignment="Left">
                <RadioButton x:Name="RbMap" Content="信号地图" IsChecked="True" Style="{StaticResource NavTabStyle}"/>
                <RadioButton x:Name="RbList" Content="信号列表" Style="{StaticResource NavTabStyle}"/>
                <RadioButton x:Name="RbLog" Content="交互日志" Style="{StaticResource NavTabStyle}" Margin="0,0,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1" Background="#1A2B3C" Margin="0">
                <!-- MAP VIEW -->
                <local:SignalMapView>
                    <local:SignalMapView.Style>
                        <Style TargetType="UserControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=RbMap}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:SignalMapView.Style>
                </local:SignalMapView>

                <!-- LIST VIEW -->
                <local:SignalListView>
                    <local:SignalListView.Style>
                        <Style TargetType="UserControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=RbList}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:SignalListView.Style>
                </local:SignalListView>

                <!-- LOG VIEW -->
                <local:SignalLogView>
                    <local:SignalLogView.Style>
                        <Style TargetType="UserControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=RbLog}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:SignalLogView.Style>
                </local:SignalLogView>
            </Grid>
        </Grid>

        <!-- 右侧列 -->
        <Grid Grid.Column="2" Background="#112233" Margin="0,10,10,10">
            <local:SignalRightPanelView />
        </Grid>
    </Grid>
</UserControl>
