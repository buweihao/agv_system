<UserControl x:Class="AgvDispatcher.Modules.SystemConfigModule.Views.MapConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:local="clr-namespace:AgvDispatcher.Modules.SystemConfigModule.Views"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6F4FF"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
        </Style>

        <Style x:Key="ViewModeToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="LightGray"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" BorderBrush="#2D5D88" BorderThickness="1" CornerRadius="4" Padding="16,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E90FF"/>
                                <Setter TargetName="b" Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#0D1724"/>
            <Setter Property="BorderBrush" Value="#1F3A60"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#12304A"/>
            <Setter Property="Foreground" Value="#DCEFFF"/>
            <Setter Property="BorderBrush" Value="#2D5D88"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0B1828"/>
            <Setter Property="Foreground" Value="#DCEFFF"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#1F3A60"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#0A111E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="地图配置" Foreground="#00BFFF" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="管理地图节点和约束路线" Foreground="#8EA8C3" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RbCanvasMode" Content="画布编辑" GroupName="MapViewMode" IsChecked="True" Style="{StaticResource ViewModeToggle}" Margin="0,0,8,0"/>
                    <RadioButton x:Name="RbTableMode" Content="表格编辑" GroupName="MapViewMode" Style="{StaticResource ViewModeToggle}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding TotalNodes, StringFormat=节点 {0}}" Foreground="#8EA8C3" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding TotalEdges, StringFormat=路径 {0}}" Foreground="#8EA8C3" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding TotalAliases, StringFormat=别名 {0}}" Foreground="#8EA8C3" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="校验地图" Command="{Binding ValidateCommand}" Style="{StaticResource ActionButtonStyle}" Background="#FF8C00" Foreground="White" BorderThickness="0" />
                    <Button Content="导入JSON" Command="{Binding ImportCommand}" Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="导出JSON" Command="{Binding ExportCommand}" Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 画布编辑模式 -->
        <local:MapEditorView Grid.Row="1"
                             Visibility="{Binding IsChecked, ElementName=RbCanvasMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- 表格编辑模式 -->
        <Grid Grid.Row="1"
              Visibility="{Binding IsChecked, ElementName=RbTableMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,10">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="地图节点" Foreground="#00BFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="新增节点" Command="{Binding AddNodeCommand}" Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="删除选中" Command="{Binding DeleteNodeCommand}" Background="#FF4500" Foreground="White" BorderThickness="0" Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="保存选中" Command="{Binding SaveNodeCommand}" Style="{StaticResource ActionButtonStyle}" Background="#00BFFF" Foreground="#04101C" BorderThickness="0" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
                <DataGrid ItemsSource="{Binding Nodes}"
                          SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="36"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#101E30"
                          Foreground="#DCEFFF"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="节点ID" Binding="{Binding NodeId}" Width="*"/>
                        <DataGridTextColumn Header="节点编码" Binding="{Binding NodeCode}" Width="*"/>
                        <DataGridTextColumn Header="节点名称" Binding="{Binding Name}" Width="*"/>
                        <DataGridComboBoxColumn Header="类型" SelectedItemBinding="{Binding NodeType}" Width="*">
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.NodeTypes, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.NodeTypes, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                        </DataGridComboBoxColumn>
                        <DataGridTextColumn Header="X坐标" Binding="{Binding Position.X}" Width="0.7*"/>
                        <DataGridTextColumn Header="Y坐标" Binding="{Binding Position.Y}" Width="0.7*"/>
                        <DataGridTextColumn Header="朝向" Binding="{Binding Heading}" Width="0.6*"/>
                        <DataGridTextColumn Header="停车容量" Binding="{Binding ParkingCapacity}" Width="0.6*"/>
                        <DataGridTextColumn Header="区域代码" Binding="{Binding AreaCode}" Width="*"/>
                        <DataGridTextColumn Header="约束品牌" Binding="{Binding AllowedBrands}" Width="*"/>
                        <DataGridCheckBoxColumn Header="是否启用" Binding="{Binding IsEnabled}" Width="0.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Margin="0,10,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="路线边缘" Foreground="#00BFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="新增路径" Command="{Binding AddEdgeCommand}" Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="删除选中" Command="{Binding DeleteEdgeCommand}" Background="#FF4500" Foreground="White" BorderThickness="0" Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="保存选中" Command="{Binding SaveEdgeCommand}" Style="{StaticResource ActionButtonStyle}" Background="#00BFFF" Foreground="#04101C" BorderThickness="0" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
                <DataGrid ItemsSource="{Binding Edges}"
                          SelectedItem="{Binding SelectedEdge, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="36"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#101E30"
                          Foreground="#DCEFFF"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="边缘ID" Binding="{Binding EdgeId}" Width="*"/>
                        <DataGridComboBoxColumn Header="起始节点" SelectedValueBinding="{Binding FromNodeId}" SelectedValuePath="NodeId" DisplayMemberPath="NodeId" Width="*">
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.Nodes, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.Nodes, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                        </DataGridComboBoxColumn>
                        <DataGridComboBoxColumn Header="结束节点" SelectedValueBinding="{Binding ToNodeId}" SelectedValuePath="NodeId" DisplayMemberPath="NodeId" Width="*">
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.Nodes, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.Nodes, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                        </DataGridComboBoxColumn>
                        <DataGridComboBoxColumn Header="方向" SelectedItemBinding="{Binding Direction}" Width="*">
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.EdgeDirections, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.EdgeDirections, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                        </DataGridComboBoxColumn>
                        <DataGridTextColumn Header="约束品牌" Binding="{Binding AllowedBrands}" Width="*"/>
                        <DataGridTextColumn Header="限速(m/s)" Binding="{Binding MaxSpeed}" Width="0.8*"/>
                        <DataGridTextColumn Header="最大车流量" Binding="{Binding MaxVehicleFlow}" Width="0.8*"/>
                        <DataGridCheckBoxColumn Header="单向/锁" Binding="{Binding IsLocked}" Width="0.5*"/>
                        <DataGridCheckBoxColumn Header="是否启用" Binding="{Binding IsEnabled}" Width="0.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Margin="0,10,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="位置别名配置" Foreground="#00BFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="新增别名" Command="{Binding AddAliasCommand}" Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="删除选中" Command="{Binding DeleteAliasCommand}" Background="#FF4500" Foreground="White" BorderThickness="0" Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="保存选中" Command="{Binding SaveAliasCommand}" Style="{StaticResource ActionButtonStyle}" Background="#00BFFF" Foreground="#04101C" BorderThickness="0" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
                <DataGrid ItemsSource="{Binding Aliases}"
                          SelectedItem="{Binding SelectedAlias, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="36"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#101E30"
                          Foreground="#DCEFFF"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="别名ID" Binding="{Binding AliasId}" Width="1.5*" IsReadOnly="True" />
                        <DataGridComboBoxColumn Header="节点ID" SelectedValueBinding="{Binding NodeId}" SelectedValuePath="NodeId" DisplayMemberPath="NodeId" Width="*" >
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.Nodes, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.Nodes, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                        </DataGridComboBoxColumn>
                        <DataGridTextColumn Header="别名值" Binding="{Binding AliasValue}" Width="*"/>
                        <DataGridTextColumn Header="约束品牌" Binding="{Binding Brand}" Width="*"/>
                        <DataGridCheckBoxColumn Header="是否启用" Binding="{Binding IsEnabled}" Width="0.5*"/>
                        <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource PanelBorderStyle}" Margin="0,10,0,0" Visibility="{Binding IsValidationResultsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="地图校验结果" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>
                <DataGrid ItemsSource="{Binding ValidationResults}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="36"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#101E30"
                          Foreground="#DCEFFF"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                          MaxHeight="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="等级" Binding="{Binding Level}" Width="0.5*"/>
                        <DataGridTextColumn Header="对象类型" Binding="{Binding ObjectType}" Width="*"/>
                        <DataGridTextColumn Header="对象编号" Binding="{Binding ObjectId}" Width="*"/>
                        <DataGridTextColumn Header="信息" Binding="{Binding Message}" Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        </Grid>
    </Grid>
</UserControl>
