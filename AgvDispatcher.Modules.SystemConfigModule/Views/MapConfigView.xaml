<UserControl x:Class="AgvDispatcher.Modules.SystemConfigModule.Views.MapConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:local="clr-namespace:AgvDispatcher.Modules.SystemConfigModule.Views"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6F4FF"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
        </Style>

        <Style x:Key="ViewModeToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="LightGray"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" BorderBrush="#2D5D88" BorderThickness="1" CornerRadius="4" Padding="16,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E90FF"/>
                                <Setter TargetName="b" Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#0D1724"/>
            <Setter Property="BorderBrush" Value="#1F3A60"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#12304A"/>
            <Setter Property="Foreground" Value="#DCEFFF"/>
            <Setter Property="BorderBrush" Value="#2D5D88"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0B1828"/>
            <Setter Property="Foreground" Value="#DCEFFF"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#1F3A60"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#0A111E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="地图编辑与管理" Foreground="#00BFFF" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CurrentDraftId, StringFormat=当前草稿 {0}}" Foreground="#8EA8C3" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RbCanvasMode" Content="画布编辑" GroupName="MapViewMode" IsChecked="True" Style="{StaticResource ViewModeToggle}" Margin="0,0,8,0"/>
                    <RadioButton x:Name="RbTableMode" Content="表格编辑" GroupName="MapViewMode" Style="{StaticResource ViewModeToggle}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding TotalNodes, StringFormat=点位 {0}}" Foreground="#8EA8C3" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding TotalEdges, StringFormat=路线 {0}}" Foreground="#8EA8C3" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding TotalAliases, StringFormat=映射 {0}}" Foreground="#8EA8C3" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="新建草稿" Command="{Binding NewDraftCommand}" Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="保存草稿" Command="{Binding SaveDraftCommand}" Style="{StaticResource ActionButtonStyle}" Background="#00BFFF" Foreground="#04101C" BorderThickness="0" FontWeight="Bold"/>
                    <Button Content="校验" Command="{Binding ValidateCommand}" Style="{StaticResource ActionButtonStyle}" Background="#FF8C00" Foreground="White" BorderThickness="0" />
                    <Button Content="发布" Command="{Binding PublishDraftCommand}" Style="{StaticResource ActionButtonStyle}" Background="#28A745" Foreground="White" BorderThickness="0"/>
                    <Menu Background="Transparent" BorderThickness="0" Margin="8,0,0,0" VerticalAlignment="Center">
                        <MenuItem Header="更多操作" Height="32" MinWidth="88" Background="#12304A" Foreground="#DCEFFF" BorderBrush="#2D5D88" BorderThickness="1">
                            <MenuItem Header="导入草稿" Command="{Binding ImportCommand}"/>
                            <MenuItem Header="导出 JSON" Command="{Binding ExportCommand}"/>
                            <Separator/>
                            <MenuItem Header="刷新数据" Command="{Binding RefreshCommand}"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 鐢诲竷缂栬緫妯″紡 -->
        <local:MapEditorView Grid.Row="1"
                             Visibility="{Binding IsChecked, ElementName=RbCanvasMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- 琛ㄦ牸缂栬緫妯″紡 -->
        <Grid Grid.Row="1"
              Visibility="{Binding IsChecked, ElementName=RbTableMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,10">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="地图点位" Foreground="#00BFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="新增点位" Command="{Binding AddNodeCommand}" Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="删除选中" Command="{Binding DeleteNodeCommand}" Background="#FF4500" Foreground="White" BorderThickness="0" Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="保存选中" Command="{Binding SaveNodeCommand}" Style="{StaticResource ActionButtonStyle}" Background="#00BFFF" Foreground="#04101C" BorderThickness="0" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
                <DataGrid ItemsSource="{Binding Nodes}"
                          SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="36"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#101E30"
                          Foreground="#DCEFFF"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="点位ID" Binding="{Binding NodeId}" Width="*"/>
                        <DataGridTextColumn Header="点位编码" Binding="{Binding NodeCode}" Width="*"/>
                        <DataGridTextColumn Header="点位名称" Binding="{Binding Name}" Width="*"/>
                        <DataGridComboBoxColumn Header="类型"
                                                SelectedValueBinding="{Binding NodeType}"
                                                SelectedValuePath="Value"
                                                DisplayMemberPath="DisplayName"
                                                Width="*">
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.NodeTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.NodeTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                        </DataGridComboBoxColumn>
                        <DataGridTextColumn Header="X坐标" Binding="{Binding Position.X}" Width="0.7*"/>
                        <DataGridTextColumn Header="Y坐标" Binding="{Binding Position.Y}" Width="0.7*"/>
                        <DataGridTextColumn Header="朝向" Binding="{Binding Heading}" Width="0.6*"/>
                        <DataGridTextColumn Header="停车容量" Binding="{Binding ParkingCapacity}" Width="0.6*"/>
                        <DataGridTextColumn Header="区域代码" Binding="{Binding AreaCode}" Width="*"/>
                        <DataGridTextColumn Header="约束品牌" Binding="{Binding AllowedBrands}" Width="*"/>
                        <DataGridCheckBoxColumn Header="是否启用" Binding="{Binding IsEnabled}" Width="0.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Margin="0,10,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="路线边" Foreground="#00BFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="新增路线" Command="{Binding AddEdgeCommand}" Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="删除选中" Command="{Binding DeleteEdgeCommand}" Background="#FF4500" Foreground="White" BorderThickness="0" Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="保存选中" Command="{Binding SaveEdgeCommand}" Style="{StaticResource ActionButtonStyle}" Background="#00BFFF" Foreground="#04101C" BorderThickness="0" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
                <DataGrid ItemsSource="{Binding Edges}"
                          SelectedItem="{Binding SelectedEdge, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="36"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#101E30"
                          Foreground="#DCEFFF"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="路线ID" Binding="{Binding EdgeId}" Width="*"/>
                        <DataGridComboBoxColumn Header="起始点位" SelectedValueBinding="{Binding FromNodeId}" SelectedValuePath="NodeId" DisplayMemberPath="NodeId" Width="*">
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.Nodes, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.Nodes, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                        </DataGridComboBoxColumn>
                        <DataGridComboBoxColumn Header="结束点位" SelectedValueBinding="{Binding ToNodeId}" SelectedValuePath="NodeId" DisplayMemberPath="NodeId" Width="*">
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.Nodes, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.Nodes, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                        </DataGridComboBoxColumn>
                        <DataGridComboBoxColumn Header="方向"
                                                SelectedValueBinding="{Binding Direction}"
                                                SelectedValuePath="Value"
                                                DisplayMemberPath="DisplayName"
                                                Width="*">
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.EdgeDirectionOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.EdgeDirectionOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                        </DataGridComboBoxColumn>
                        <DataGridTextColumn Header="约束品牌" Binding="{Binding AllowedBrands}" Width="*"/>
                        <DataGridTextColumn Header="限速(m/s)" Binding="{Binding MaxSpeed}" Width="0.8*"/>
                        <DataGridTextColumn Header="最大车流量" Binding="{Binding MaxVehicleFlow}" Width="0.8*"/>
                        <DataGridCheckBoxColumn Header="是否启用" Binding="{Binding IsEnabled}" Width="0.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Margin="0,10,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="位置别名配置" Foreground="#00BFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="新增别名" Command="{Binding AddAliasCommand}" Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="删除选中" Command="{Binding DeleteAliasCommand}" Background="#FF4500" Foreground="White" BorderThickness="0" Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="保存选中" Command="{Binding SaveAliasCommand}" Style="{StaticResource ActionButtonStyle}" Background="#00BFFF" Foreground="#04101C" BorderThickness="0" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
                <DataGrid ItemsSource="{Binding Aliases}"
                          SelectedItem="{Binding SelectedAlias, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="36"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#101E30"
                          Foreground="#DCEFFF"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="别名ID" Binding="{Binding AliasId}" Width="1.5*" IsReadOnly="True" />
                        <DataGridComboBoxColumn Header="点位ID" SelectedValueBinding="{Binding NodeId}" SelectedValuePath="NodeId" DisplayMemberPath="NodeId" Width="*" >
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.Nodes, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.Nodes, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                        </DataGridComboBoxColumn>
                        <DataGridTextColumn Header="别名值" Binding="{Binding AliasValue}" Width="*"/>
                        <DataGridTextColumn Header="约束品牌" Binding="{Binding Brand}" Width="*"/>
                        <DataGridCheckBoxColumn Header="是否启用" Binding="{Binding IsEnabled}" Width="0.5*"/>
                        <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource PanelBorderStyle}" Margin="0,10,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="地图校验与版本" Foreground="#FF8C00" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding MapVersions}"
                                  SelectedItem="{Binding SelectedMapVersion, Mode=TwoWay}"
                                  DisplayMemberPath="Version"
                                  Width="180"
                                  Height="30"
                                  Background="#0B1828"
                                  Foreground="#DCEFFF"/>
                        <Button Content="回滚版本" Command="{Binding RollbackVersionCommand}" Style="{StaticResource ActionButtonStyle}" Background="#8B2C2C" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
                <DataGrid ItemsSource="{Binding ValidationResults}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="36"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#101E30"
                          Foreground="#DCEFFF"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                          MaxHeight="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="等级" Binding="{Binding Level}" Width="0.5*"/>
                        <DataGridTextColumn Header="对象类型" Binding="{Binding ObjectType}" Width="*"/>
                        <DataGridTextColumn Header="对象编号" Binding="{Binding ObjectId}" Width="*"/>
                        <DataGridTextColumn Header="信息" Binding="{Binding Message}" Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        </Grid>
    </Grid>
</UserControl>
