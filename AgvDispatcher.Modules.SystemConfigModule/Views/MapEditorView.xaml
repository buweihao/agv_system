<UserControl
    x:Class="AgvDispatcher.Modules.SystemConfigModule.Views.MapEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:AgvDispatcher.Modules.SystemConfigModule.Converters"
    Focusable="True"
    KeyDown="Root_KeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:ComboBoxDisplayTextConverter x:Key="ComboBoxDisplayTextConverter" />

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#18283A" />
            <Setter Property="Foreground" Value="#EAF2FF" />
            <Setter Property="BorderBrush" Value="#334B65" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#22364C" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#5D7792" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0F1D2C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="CompactToolButton"
            BasedOn="{StaticResource ToolButton}"
            TargetType="Button">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <Style x:Key="ToolGroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#91A3B6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="ToolGroupBorder" TargetType="Border">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Background" Value="#0F1C2A" />
            <Setter Property="BorderBrush" Value="#223953" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style
            x:Key="ToggleToolButton"
            BasedOn="{StaticResource ToolButton}"
            TargetType="Button">
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="#1677FF" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="#7CC4FF" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="PrimaryToolButton"
            BasedOn="{StaticResource ToolButton}"
            TargetType="Button">
            <Setter Property="Background" Value="#EAF6FF" />
            <Setter Property="Foreground" Value="#061526" />
            <Setter Property="BorderBrush" Value="#EAF6FF" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style
            x:Key="DangerToolButton"
            BasedOn="{StaticResource ToolButton}"
            TargetType="Button">
            <Setter Property="Background" Value="#FF5A3D" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#FF5A3D" />
        </Style>

        <Style x:Key="ModeBadge" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Background" Value="#1677FF" />
            <Setter Property="BorderBrush" Value="#9DD6FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="13,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="PropLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8EA8C3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="#131F2C" />
            <Setter Property="Foreground" Value="#EAF2FF" />
            <Setter Property="BorderBrush" Value="#31465F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#DCEBFF" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#101B28" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppleComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#172536" />
            <Setter Property="Foreground" Value="#F4F8FF" />
            <Setter Property="BorderBrush" Value="#3A5067" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#F4F8FF" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="MinHeight" Value="34" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border
                                        x:Name="ItemRoot"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="10">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemRoot" Property="Background" Value="#263A50" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemRoot" Property="Background" Value="#0A84FF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid
                            x:Name="TemplateRoot"
                            Height="{TemplateBinding Height}"
                            MinWidth="{TemplateBinding MinWidth}"
                            ClipToBounds="False"
                            SnapsToDevicePixels="True">
                            <ToggleButton
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                ClickMode="Press"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Border
                                    x:Name="Root"
                                    Width="{Binding ActualWidth, ElementName=TemplateRoot}"
                                    Height="{TemplateBinding Height}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="18"
                                    SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            Foreground="{TemplateBinding Foreground}"
                                            TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource ComboBoxDisplayTextConverter}">
                                                    <Binding Path="SelectedItem" RelativeSource="{RelativeSource TemplatedParent}" />
                                                    <Binding Path="DisplayMemberPath" RelativeSource="{RelativeSource TemplatedParent}" />
                                                    <Binding Path="SelectedValue" RelativeSource="{RelativeSource TemplatedParent}" />
                                                    <Binding Path="Text" RelativeSource="{RelativeSource TemplatedParent}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <Path
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="M 1 3 L 6 8 L 11 3"
                                            Stroke="#B8C8D9"
                                            StrokeEndLineCap="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="1.8" />
                                    </Grid>
                                </Border>
                            </ToggleButton>
                            <Popup
                                x:Name="PART_Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                PopupAnimation="Fade">

                                <Border
                                    x:Name="DropDownBorder"
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MinHeight="44"
                                    MaxHeight="240"
                                    Margin="0,5,0,0"
                                    Padding="6"
                                    Background="#121E2B"
                                    BorderBrush="#405772"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True">

                                    <Grid>
                                        <ScrollViewer
                                            x:Name="DropDownScrollViewer"
                                            MaxHeight="220"
                                            VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>

                                        <TextBlock
                                            x:Name="EmptyHint"
                                            MinHeight="32"
                                            Padding="12,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="#6F8196"
                                            Text="暂无区域数据"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1E3044" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#5F7893" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#A7D3FF" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#223850" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#A7D3FF" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownScrollViewer" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="EmptyHint" Property="Visibility" Value="Visible" />
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="44" />
                                <Setter TargetName="DropDownBorder" Property="CornerRadius" Value="10" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style BasedOn="{StaticResource AppleComboBoxStyle}" TargetType="ComboBox" />

        <Style
            x:Key="AreaSelectorComboBoxStyle"
            BasedOn="{StaticResource AppleComboBoxStyle}"
            TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Width" Value="220" />
            <Setter Property="MaxWidth" Value="220" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="#18293D" />
            <Setter Property="BorderBrush" Value="#49627E" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="_root"
        Background="#070D17">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Padding="12,10"
            Background="#0B1828"
            BorderBrush="#1F3A60"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource ToolGroupBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ToolGroupLabel}" Text="区域" />
                            <ComboBox
                                Grid.Column="1"
                                Width="220"
                                Height="28"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Center"
                                DisplayMemberPath="AreaSelectorName"
                                ItemsSource="{Binding EditorAreas}"
                                RenderTransformOrigin="0.5,0.5"
                                SelectedItem="{Binding SelectedEditorArea, Mode=TwoWay}"
                                Style="{StaticResource AreaSelectorComboBoxStyle}"
                                TextSearch.TextPath="AreaSelectorName" />
                            <Button
                                Grid.Column="2"
                                Command="{Binding AddAreaCommand}"
                                Content="新增"
                                Style="{StaticResource ToolButton}" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource ToolGroupBorder}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolGroupLabel}" Text="绘制区域" />
                            <Button
                                Command="{Binding DrawRectangleAreaCommand}"
                                Content="矩形"
                                Style="{StaticResource ToggleToolButton}"
                                Tag="{Binding IsRectangleAreaMode}" />
                            <Button
                                Command="{Binding DrawPolygonAreaCommand}"
                                Content="多边形"
                                Style="{StaticResource ToggleToolButton}"
                                Tag="{Binding IsPolygonAreaMode}" />
                            <Button
                                Command="{Binding EncloseElementsAreaCommand}"
                                Content="框选归区"
                                Style="{StaticResource ToggleToolButton}"
                                Tag="{Binding IsEncloseElementsAreaMode}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource ToolGroupBorder}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolGroupLabel}" Text="编辑" />
                            <Button
                                Command="{Binding AddNodeAtCenterCommand}"
                                Content="放置节点"
                                Style="{StaticResource ToggleToolButton}"
                                Tag="{Binding IsAddNodeMode}" />
                            <Button
                                Command="{Binding ToggleConnectModeCommand}"
                                Content="连线模式"
                                Style="{StaticResource ToggleToolButton}"
                                Tag="{Binding IsConnectMode}" />
                            <Button
                                Command="{Binding TogglePlaceStationModeCommand}"
                                Content="设置充电桩"
                                Style="{StaticResource ToggleToolButton}"
                                Tag="{Binding IsPlaceStationMode}" />
                            <Button
                                Command="{Binding DeleteRectangleCommand}"
                                Content="框选删除"
                                Style="{StaticResource ToggleToolButton}"
                                Tag="{Binding IsDeleteElementsMode}" />
                            <Button
                                Command="{Binding DeleteSelectionCommand}"
                                Content="删除选中"
                                Style="{StaticResource DangerToolButton}" />
                        </StackPanel>
                    </Border>

                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Border Style="{StaticResource ToolGroupBorder}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolGroupLabel}" Text="辅助" />
                            <Button
                                Command="{Binding UndoCommand}"
                                Content="撤销"
                                Style="{StaticResource ToolButton}" />
                            <Button
                                Command="{Binding RedoCommand}"
                                Content="重做"
                                Style="{StaticResource ToolButton}" />
                            <Button
                                Command="{Binding ToggleGridSnapCommand}"
                                Content="对齐网格"
                                Style="{StaticResource ToggleToolButton}"
                                Tag="{Binding IsGridSnapEnabled}" />
                            <Button
                                Command="{Binding ToggleUnitCommand}"
                                Content="米/像素"
                                Style="{StaticResource ToolButton}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ToolGroupBorder}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolGroupLabel}" Text="当前模式" />
                            <Border>
                                <Border.Style>
                                    <Style BasedOn="{StaticResource ModeBadge}" TargetType="Border">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsAddNodeMode}" Value="False" />
                                                    <Condition Binding="{Binding IsConnectMode}" Value="False" />
                                                    <Condition Binding="{Binding IsPlaceStationMode}" Value="False" />
                                                    <Condition Binding="{Binding IsRectangleAreaMode}" Value="False" />
                                                    <Condition Binding="{Binding IsPolygonAreaMode}" Value="False" />
                                                    <Condition Binding="{Binding IsEncloseElementsAreaMode}" Value="False" />
                                                    <Condition Binding="{Binding IsDeleteElementsMode}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="选择编辑" />
                            </Border>
                            <Border Style="{StaticResource ModeBadge}" Visibility="{Binding IsAddNodeMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="放置节点" />
                            </Border>
                            <Border Style="{StaticResource ModeBadge}" Visibility="{Binding IsConnectMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="连线模式" />
                            </Border>
                            <Border Style="{StaticResource ModeBadge}" Visibility="{Binding IsPlaceStationMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="设置充电桩" />
                            </Border>
                            <Border Style="{StaticResource ModeBadge}" Visibility="{Binding IsRectangleAreaMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="绘制矩形" />
                            </Border>
                            <Border Style="{StaticResource ModeBadge}" Visibility="{Binding IsPolygonAreaMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="绘制多边形" />
                            </Border>
                            <Border Style="{StaticResource ModeBadge}" Visibility="{Binding IsEncloseElementsAreaMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="框选归区" />
                            </Border>
                            <Border Style="{StaticResource ModeBadge}" Visibility="{Binding IsDeleteElementsMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="框选删除" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border
            x:Name="_viewport"
            Grid.Row="1"
            Grid.Column="0"
            ClipToBounds="True"
            Focusable="True"
            LostMouseCapture="Viewport_LostMouseCapture"
            MouseMove="Viewport_MouseMove"
            MouseRightButtonDown="Viewport_MouseRightButtonDown"
            MouseRightButtonUp="Viewport_MouseRightButtonUp"
            PreviewMouseLeftButtonDown="Viewport_PreviewMouseLeftButtonDown"
            PreviewMouseWheel="Viewport_PreviewMouseWheel">
            <Border.Background>
                <DrawingBrush
                    TileMode="Tile"
                    Viewport="0,0,20,20"
                    ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="0,0" EndPoint="20,0" />
                                    <LineGeometry StartPoint="0,0" EndPoint="0,20" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#102036" Thickness="1" />
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>

            <Canvas
                x:Name="_canvas"
                Width="860"
                Height="580"
                Background="Transparent"
                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                MouseMove="Canvas_MouseMove"
                LostMouseCapture="Canvas_LostMouseCapture">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="_canvasScale" />
                        <TranslateTransform x:Name="_canvasTranslate" />
                    </TransformGroup>
                </Canvas.RenderTransform>

                <ItemsControl ItemsSource="{Binding EditorAreas}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Polygon
                                Cursor="Hand"
                                Fill="{Binding Fill}"
                                MouseLeftButtonDown="Area_MouseLeftButtonDown"
                                Opacity="{Binding Opacity}"
                                Points="{Binding PointsText}"
                                Stroke="{Binding Stroke}"
                                StrokeThickness="{Binding StrokeThickness}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding EditorAreas}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding LabelLeft}" />
                            <Setter Property="Canvas.Top" Value="{Binding LabelTop}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="6,2"
                                Background="#AA0B1828"
                                BorderBrush="{Binding Stroke}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Cursor="Hand"
                                MouseLeftButtonDown="Area_MouseLeftButtonDown">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#DCEFFF"
                                    Text="{Binding AreaDisplayName}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding EditorEdges}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Line
                                Cursor="Hand"
                                MouseLeftButtonDown="Edge_MouseLeftButtonDown"
                                Opacity="{Binding Opacity}"
                                Stroke="{Binding Stroke}"
                                StrokeThickness="{Binding StrokeThickness}"
                                X1="{Binding X1}"
                                X2="{Binding X2}"
                                Y1="{Binding Y1}"
                                Y2="{Binding Y2}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding EditorEdges}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Polyline
                                IsHitTestVisible="False"
                                Points="{Binding ArrowPoints}"
                                Stroke="{Binding Stroke}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding EditorEdges}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Polyline
                                IsHitTestVisible="False"
                                Points="{Binding ReverseArrowPoints}"
                                Stroke="{Binding Stroke}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl Panel.ZIndex="30" ItemsSource="{Binding EditorStations}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
                            <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="14"
                                Height="14"
                                Background="{Binding Fill}"
                                BorderBrush="{Binding Stroke}"
                                BorderThickness="{Binding StrokeThickness}"
                                CornerRadius="2"
                                Cursor="Hand"
                                MouseLeftButtonDown="Station_MouseLeftButtonDown"
                                ToolTip="{Binding StationId}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    Foreground="White"
                                    Text="⚡" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding EditorNodes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
                            <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse
                                Width="18"
                                Height="18"
                                Cursor="Hand"
                                Fill="{Binding Fill}"
                                MouseLeftButtonDown="Node_MouseLeftButtonDown"
                                MouseLeftButtonUp="Node_MouseLeftButtonUp"
                                LostMouseCapture="Node_LostMouseCapture"
                                Opacity="{Binding Opacity}"
                                Stroke="{Binding Stroke}"
                                StrokeThickness="{Binding StrokeThickness}">
                                <Ellipse.ToolTip>
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" Text="{Binding NodeId}" />
                                        <TextBlock Text="{Binding NodeType}" />
                                    </StackPanel>
                                </Ellipse.ToolTip>
                            </Ellipse>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding EditorNodes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding LabelLeft}" />
                            <Setter Property="Canvas.Top" Value="{Binding LabelTop}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="5,2"
                                Background="#1E3A5F"
                                CornerRadius="3"
                                IsHitTestVisible="False">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding NodeCode}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Polyline
                    x:Name="_polygonPreview"
                    Fill="#22FFD700"
                    IsHitTestVisible="False"
                    Stroke="#FFD700"
                    StrokeDashArray="4 3"
                    StrokeThickness="2"
                    Visibility="Collapsed" />
                <Rectangle
                    x:Name="_selectionBox"
                    Fill="#3300BFFF"
                    IsHitTestVisible="False"
                    Stroke="#00BFFF"
                    StrokeDashArray="3 2"
                    StrokeThickness="1"
                    Visibility="Collapsed" />
            </Canvas>
        </Border>

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="10"
            Padding="8,4"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="#0B1828"
            BorderBrush="#1F3A60"
            BorderThickness="1"
            CornerRadius="3"
            IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="#8EA8C3"
                    Text="{Binding CoordReadout}" />
                <TextBlock
                    Margin="16,0,0,0"
                    FontSize="12"
                    Foreground="#607B96"
                    Text="滚轮缩放 · 按住右键拖拽视图" />
            </StackPanel>
        </Border>

        <Border
            Grid.Row="1"
            Grid.Column="1"
            Padding="12"
            Background="#0B1828"
            BorderBrush="#1F3A60"
            BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="#00BFFF"
                        Text="属性" />

                    <TextBlock
                        FontSize="12"
                        Foreground="#6E8298"
                        LineHeight="20"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        在画布上选中节点、边、区域或充电桩进行编辑。矩形/多边形用于新建区域；框选归区会把框内节点和路径边归入当前区域。Esc 取消绘制。
                    </TextBlock>

                    <StackPanel DataContext="{Binding SelectedEditorNode}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=DataContext}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource PropLabel}" Text="节点编号" />
                        <TextBox
                            Padding="6,4"
                            Background="#11243A"
                            BorderThickness="0"
                            Foreground="#8EA8C3"
                            IsReadOnly="True"
                            Text="{Binding NodeId, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource PropLabel}" Text="类型" />
                        <ComboBox
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding DataContext.NodeTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            SelectedValue="{Binding NodeType, Mode=TwoWay}"
                            SelectedValuePath="Value" />
                        <TextBlock Style="{StaticResource PropLabel}" Text="所属区域" />
                        <ComboBox
                            DisplayMemberPath="AreaSelectorName"
                            ItemsSource="{Binding DataContext.EditorAreas, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            SelectedValue="{Binding AreaCode, Mode=TwoWay}"
                            SelectedValuePath="AreaId" />
                        <TextBlock Style="{StaticResource PropLabel}" Text="X (像素)" />
                        <TextBox Padding="6,4" Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource PropLabel}" Text="Y (像素)" />
                        <TextBox Padding="6,4" Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Margin="0,12,0,0"
                            Content="启用"
                            Foreground="#DCEFFF"
                            IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel DataContext="{Binding SelectedEditorArea}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=DataContext}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource PropLabel}" Text="区域编号" />
                        <TextBox Padding="6,4" Text="{Binding AreaId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource PropLabel}" Text="区域名称" />
                        <TextBox Padding="6,4" Text="{Binding AreaName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource PropLabel}" Text="区域类型" />
                        <ComboBox
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding DataContext.AreaTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            SelectedValue="{Binding AreaType, Mode=TwoWay}"
                            SelectedValuePath="Value" />
                        <TextBlock Style="{StaticResource PropLabel}" Text="颜色" />
                        <TextBox Padding="6,4" Text="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding DataContext.AreaColorOptions, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Width="28"
                                        Height="24"
                                        Margin="0,0,6,6"
                                        Background="{Binding}"
                                        BorderBrush="#DCEFFF"
                                        BorderThickness="1"
                                        Command="{Binding DataContext.SetSelectedAreaColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource PropLabel}" Text="边界点" />
                        <TextBox
                            Height="72"
                            Padding="6,4"
                            AcceptsReturn="True"
                            Text="{Binding BoundaryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <CheckBox
                            Margin="0,12,0,0"
                            Content="启用"
                            Foreground="#DCEFFF"
                            IsChecked="{Binding Enabled, Mode=TwoWay}" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="11"
                            Foreground="#6E8298"
                            Text="边界格式：x,y; x,y; x,y。矩形和多边形工具会自动生成这些静态边界点。"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel DataContext="{Binding SelectedEditorEdge}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=DataContext}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource PropLabel}" Text="边编号" />
                        <TextBox
                            Padding="6,4"
                            Background="#11243A"
                            BorderThickness="0"
                            Foreground="#8EA8C3"
                            IsReadOnly="True"
                            Text="{Binding EdgeId, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource PropLabel}" Text="起点 / 终点" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                Padding="6,4"
                                Background="#11243A"
                                BorderThickness="0"
                                Foreground="#8EA8C3"
                                IsReadOnly="True"
                                Text="{Binding FromNodeId, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="8,0"
                                VerticalAlignment="Center"
                                Foreground="#8EA8C3"
                                Text="→" />
                            <TextBox
                                Grid.Column="2"
                                Padding="6,4"
                                Background="#11243A"
                                BorderThickness="0"
                                Foreground="#8EA8C3"
                                IsReadOnly="True"
                                Text="{Binding ToNodeId, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Style="{StaticResource PropLabel}" Text="路线成本" />
                        <TextBox
                            Padding="6,4"
                            Background="#11243A"
                            BorderThickness="0"
                            Foreground="#DCEFFF"
                            Text="{Binding Model.Cost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource PropLabel}" Text="方向" />
                        <ComboBox
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding DataContext.EdgeDirectionOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            SelectedValue="{Binding Direction, Mode=TwoWay}"
                            SelectedValuePath="Value" />
                        <Button
                            Margin="0,10,0,0"
                            Command="{Binding DataContext.ReverseSelectedEdgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Content="交换起点和终点"
                            Style="{StaticResource ToolButton}" />
                        <CheckBox
                            Margin="0,12,0,0"
                            Content="启用"
                            Foreground="#DCEFFF"
                            IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="#8EA8C3"
                            Text="静态封闭请使用禁用或方向配置。" />
                    </StackPanel>

                    <StackPanel DataContext="{Binding SelectedEditorStation}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=DataContext}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource PropLabel}" Text="充电桩编号" />
                        <TextBox
                            Padding="6,4"
                            Background="#11243A"
                            BorderThickness="0"
                            Foreground="#8EA8C3"
                            IsReadOnly="True"
                            Text="{Binding StationId, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource PropLabel}" Text="绑定节点" />
                        <TextBox
                            Padding="6,4"
                            Background="#11243A"
                            BorderThickness="0"
                            Foreground="#8EA8C3"
                            IsReadOnly="True"
                            Text="{Binding NodeId, Mode=OneWay}" />
                        <TextBlock
                            Margin="0,12,0,0"
                            FontSize="11"
                            Foreground="#6E8298"
                            Text="充电桩功率、品牌等参数请在充电桩配置页精确编辑。"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border
                        Margin="0,16,0,0"
                        Padding="0,12,0,0"
                        BorderBrush="#1F3A60"
                        BorderThickness="0,1,0,0">
                        <StackPanel DataContext="{Binding Settings}">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="#00BFFF"
                                Text="比例尺" />
                            <TextBlock Style="{StaticResource PropLabel}" Text="每米像素数" />
                            <TextBox Padding="6,4" Text="{Binding PixelsPerMeter, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Style="{StaticResource PropLabel}" Text="原点 X (像素)" />
                            <TextBox Padding="6,4" Text="{Binding OriginX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Style="{StaticResource PropLabel}" Text="原点 Y (像素)" />
                            <TextBox Padding="6,4" Text="{Binding OriginY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
