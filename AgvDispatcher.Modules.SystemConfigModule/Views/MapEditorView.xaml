<UserControl x:Class="AgvDispatcher.Modules.SystemConfigModule.Views.MapEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             KeyDown="Root_KeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#12304A"/>
            <Setter Property="Foreground" Value="#DCEFFF"/>
            <Setter Property="BorderBrush" Value="#2D5D88"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 切换型工具按钮：通过 Tag 绑定布尔，激活时高亮 -->
        <Style x:Key="ToggleToolButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="#1E90FF"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PropLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8EA8C3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="_root" Background="#070D17"
          MouseRightButtonDown="Root_MouseRightButtonDown"
          MouseRightButtonUp="Root_MouseRightButtonUp">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#0B1828" BorderBrush="#1F3A60" BorderThickness="0,0,0,1" Padding="12,8">
            <WrapPanel>
                <Button Content="新增区域" Style="{StaticResource ToolButton}" Command="{Binding AddAreaCommand}"/>
                <Button Content="新增节点" Style="{StaticResource ToolButton}" Command="{Binding AddNodeAtCenterCommand}"/>
                <Button Content="连线模式" Style="{StaticResource ToggleToolButton}" Tag="{Binding IsConnectMode}" Command="{Binding ToggleConnectModeCommand}"/>
                <Button Content="放置充电桩" Style="{StaticResource ToggleToolButton}" Tag="{Binding IsPlaceStationMode}" Command="{Binding TogglePlaceStationModeCommand}"/>
                <Button Content="删除选中" Style="{StaticResource ToolButton}" Background="#FF4500" Foreground="White" BorderThickness="0" Command="{Binding DeleteSelectionCommand}"/>
                <Border Width="1" Background="#1F3A60" Margin="4,2,12,2"/>
                <Button Content="撤销" Style="{StaticResource ToolButton}" Command="{Binding UndoCommand}"/>
                <Button Content="重做" Style="{StaticResource ToolButton}" Command="{Binding RedoCommand}"/>
                <Border Width="1" Background="#1F3A60" Margin="4,2,12,2"/>
                <Button Content="对齐网格" Style="{StaticResource ToggleToolButton}" Tag="{Binding IsGridSnapEnabled}" Command="{Binding ToggleGridSnapCommand}"/>
                <Button Content="米/像素" Style="{StaticResource ToolButton}" Command="{Binding ToggleUnitCommand}"/>
                <Border Width="1" Background="#1F3A60" Margin="4,2,12,2"/>
                <Button Content="保存草稿" Style="{StaticResource ToolButton}" Background="#00BFFF" Foreground="#04101C" BorderThickness="0" FontWeight="Bold" Command="{Binding SaveAllCommand}"/>
            </WrapPanel>
        </Border>

        <!-- 画布 -->
        <Border Grid.Row="1" Grid.Column="0" ClipToBounds="True">
            <Border.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="0,0" EndPoint="20,0"/>
                                    <LineGeometry StartPoint="0,0" EndPoint="0,20"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                            <GeometryDrawing.Pen>
                                <Pen Thickness="1" Brush="#102036"/>
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>

            <Canvas x:Name="_canvas" Width="860" Height="580" Background="Transparent"
                    MouseWheel="Canvas_MouseWheel"
                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                    MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                    MouseMove="Canvas_MouseMove">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="_canvasScale"/>
                        <TranslateTransform x:Name="_canvasTranslate"/>
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- 边层 -->
                <ItemsControl ItemsSource="{Binding EditorAreas}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Polygon Points="{Binding PointsText}"
                                     Fill="{Binding Fill}"
                                     Stroke="{Binding Stroke}"
                                     StrokeThickness="{Binding StrokeThickness}"
                                     Opacity="{Binding Opacity}"
                                     Cursor="Hand"
                                     MouseLeftButtonDown="Area_MouseLeftButtonDown"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding EditorAreas}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding LabelLeft}"/>
                            <Setter Property="Canvas.Top" Value="{Binding LabelTop}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#AA0B1828" BorderBrush="{Binding Stroke}" BorderThickness="1" CornerRadius="3" Padding="6,2" IsHitTestVisible="False">
                                <TextBlock Text="{Binding AreaDisplayName}" Foreground="#DCEFFF" FontSize="11"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding EditorEdges}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                  Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
                                  Opacity="{Binding Opacity}" Cursor="Hand"
                                  MouseLeftButtonDown="Edge_MouseLeftButtonDown"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 箭头层 -->
                <ItemsControl ItemsSource="{Binding EditorEdges}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Polyline Points="{Binding ArrowPoints}" Stroke="{Binding Stroke}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      IsHitTestVisible="False"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 充电桩层 -->
                <ItemsControl ItemsSource="{Binding EditorStations}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                            <Setter Property="Canvas.Top" Value="{Binding CanvasTop}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="14" Height="14" CornerRadius="2"
                                    Background="{Binding Fill}" BorderBrush="{Binding Stroke}" BorderThickness="{Binding StrokeThickness}"
                                    Cursor="Hand" ToolTip="{Binding StationId}"
                                    MouseLeftButtonDown="Station_MouseLeftButtonDown">
                                <TextBlock Text="⚡" FontSize="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 节点层 -->
                <ItemsControl ItemsSource="{Binding EditorNodes}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                            <Setter Property="Canvas.Top" Value="{Binding CanvasTop}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Width="18" Height="18"
                                     Fill="{Binding Fill}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
                                     Opacity="{Binding Opacity}" Cursor="Hand"
                                     MouseLeftButtonDown="Node_MouseLeftButtonDown"
                                     MouseLeftButtonUp="Node_MouseLeftButtonUp">
                                <Ellipse.ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="{Binding NodeId}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding NodeType}"/>
                                    </StackPanel>
                                </Ellipse.ToolTip>
                            </Ellipse>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 节点标签层 -->
                <ItemsControl ItemsSource="{Binding EditorNodes}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding LabelLeft}"/>
                            <Setter Property="Canvas.Top" Value="{Binding LabelTop}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E3A5F" CornerRadius="3" Padding="5,2" IsHitTestVisible="False">
                                <TextBlock Text="{Binding NodeCode}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 框选矩形 -->
                <Rectangle x:Name="_selectionBox" Visibility="Collapsed"
                           Stroke="#00BFFF" StrokeThickness="1" StrokeDashArray="3 2"
                           Fill="#3300BFFF" IsHitTestVisible="False"/>
            </Canvas>
        </Border>

        <!-- 角落坐标读数 -->
        <Border Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"
                Background="#0B1828" BorderBrush="#1F3A60" BorderThickness="1" CornerRadius="3" Padding="8,4" IsHitTestVisible="False">
            <TextBlock Text="{Binding CoordReadout}" Foreground="#8EA8C3" FontSize="12" FontFamily="Consolas"/>
        </Border>

        <!-- 属性面板 -->
        <Border Grid.Row="1" Grid.Column="1" Background="#0B1828" BorderBrush="#1F3A60" BorderThickness="1,0,0,0" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="属性" Foreground="#00BFFF" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>

                    <!-- 无选中提示 -->
                    <TextBlock Text="在画布上选中节点 / 边 / 充电桩以编辑其属性。&#x0a;&#x0a;操作提示：&#x0a;• 左键拖动节点改坐标&#x0a;• 连线模式：节点拖到节点建边&#x0a;• 放置充电桩：点 Charge 节点&#x0a;• 空白拖框选；Delete 删除&#x0a;• 滚轮缩放、右键拖平移、右键双击复位&#x0a;• Ctrl+Z 撤销 / Ctrl+Y 重做"
                               Foreground="#6E8298" FontSize="12" TextWrapping="Wrap" LineHeight="20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 节点属性 -->
                    <StackPanel DataContext="{Binding SelectedEditorNode}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=DataContext}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="节点编号" Style="{StaticResource PropLabel}"/>
                        <TextBox Text="{Binding NodeId, Mode=OneWay}" IsReadOnly="True" Background="#11243A" Foreground="#8EA8C3" BorderThickness="0" Padding="6,4"/>
                        <TextBlock Text="类型" Style="{StaticResource PropLabel}"/>
                        <ComboBox SelectedValue="{Binding NodeType, Mode=TwoWay}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="DisplayName"
                                  ItemsSource="{Binding DataContext.NodeTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <TextBlock Text="X (像素)" Style="{StaticResource PropLabel}"/>
                        <TextBlock Text="所属区域" Style="{StaticResource PropLabel}"/>
                        <ComboBox SelectedValue="{Binding AreaCode, Mode=TwoWay}"
                                  SelectedValuePath="AreaId"
                                  DisplayMemberPath="AreaDisplayName"
                                  ItemsSource="{Binding DataContext.EditorAreas, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <TextBox Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                        <TextBlock Text="Y (像素)" Style="{StaticResource PropLabel}"/>
                        <TextBox Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                        <CheckBox Content="启用" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Foreground="#DCEFFF" Margin="0,12,0,0"/>
                    </StackPanel>

                    <!-- 边属性 -->
                    <StackPanel DataContext="{Binding SelectedEditorArea}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=DataContext}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="区域编号" Style="{StaticResource PropLabel}"/>
                        <TextBox Text="{Binding AreaId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                        <TextBlock Text="区域名称" Style="{StaticResource PropLabel}"/>
                        <TextBox Text="{Binding AreaName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                        <TextBlock Text="区域类型" Style="{StaticResource PropLabel}"/>
                        <ComboBox SelectedValue="{Binding AreaType, Mode=TwoWay}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="DisplayName"
                                  ItemsSource="{Binding DataContext.AreaTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <TextBlock Text="颜色" Style="{StaticResource PropLabel}"/>
                        <TextBox Text="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                        <TextBlock Text="边界点" Style="{StaticResource PropLabel}"/>
                        <TextBox Text="{Binding BoundaryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 Height="72"
                                 TextWrapping="Wrap"
                                 Padding="6,4"/>
                        <CheckBox Content="启用" IsChecked="{Binding Enabled, Mode=TwoWay}" Foreground="#DCEFFF" Margin="0,12,0,0"/>
                        <TextBlock Text="边界格式：x,y; x,y; x,y。颜色格式：#RRGGBB。保存草稿后不切换运行图，发布地图后运行监控同步显示。"
                                   Foreground="#6E8298" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>

                    <StackPanel DataContext="{Binding SelectedEditorEdge}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=DataContext}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="边编号" Style="{StaticResource PropLabel}"/>
                        <TextBox Text="{Binding EdgeId, Mode=OneWay}" IsReadOnly="True" Background="#11243A" Foreground="#8EA8C3" BorderThickness="0" Padding="6,4"/>
                        <TextBlock Text="方向" Style="{StaticResource PropLabel}"/>
                        <ComboBox SelectedValue="{Binding Direction, Mode=TwoWay}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="DisplayName"
                                  ItemsSource="{Binding DataContext.EdgeDirectionOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <CheckBox Content="启用" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Foreground="#DCEFFF" Margin="0,12,0,0"/>
                        <TextBlock Text="静态封闭请使用禁用或方向配置" Foreground="#8EA8C3" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- 充电桩属性 -->
                    <StackPanel DataContext="{Binding SelectedEditorStation}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=DataContext}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="充电桩编号" Style="{StaticResource PropLabel}"/>
                        <TextBox Text="{Binding StationId, Mode=OneWay}" IsReadOnly="True" Background="#11243A" Foreground="#8EA8C3" BorderThickness="0" Padding="6,4"/>
                        <TextBlock Text="绑定节点" Style="{StaticResource PropLabel}"/>
                        <TextBox Text="{Binding NodeId, Mode=OneWay}" IsReadOnly="True" Background="#11243A" Foreground="#8EA8C3" BorderThickness="0" Padding="6,4"/>
                        <TextBlock Text="（充电桩的功率/品牌等参数请在 充电桩配置 页精确编辑）" Foreground="#6E8298" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>

                    <!-- 比例尺设置 -->
                    <Border BorderBrush="#1F3A60" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
                        <StackPanel DataContext="{Binding Settings}">
                            <TextBlock Text="比例尺" Foreground="#00BFFF" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="每米像素数" Style="{StaticResource PropLabel}"/>
                            <TextBox Text="{Binding PixelsPerMeter, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Padding="6,4"/>
                            <TextBlock Text="原点 X (像素)" Style="{StaticResource PropLabel}"/>
                            <TextBox Text="{Binding OriginX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Padding="6,4"/>
                            <TextBlock Text="原点 Y (像素)" Style="{StaticResource PropLabel}"/>
                            <TextBox Text="{Binding OriginY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Padding="6,4"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
