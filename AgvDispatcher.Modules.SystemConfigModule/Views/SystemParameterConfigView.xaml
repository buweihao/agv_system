<UserControl x:Class="AgvDispatcher.Modules.SystemConfigModule.Views.SystemParameterConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6F4FF"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxBaseStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#0D1724"/>
            <Setter Property="BorderBrush" Value="#1F3A60"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8EA8C3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#08111C"/>
            <Setter Property="BorderBrush" Value="#24507A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#12304A"/>
            <Setter Property="Foreground" Value="#DCEFFF"/>
            <Setter Property="BorderBrush" Value="#2D5D88"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#00BFFF"/>
            <Setter Property="Foreground" Value="#04101C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0B1828"/>
            <Setter Property="Foreground" Value="#DCEFFF"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#1F3A60"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#0A111E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="系统参数配置" Foreground="#00BFFF" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#8EA8C3" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalCount, StringFormat=总数 {0}}" Foreground="#8EA8C3" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    
                    <ComboBox ItemsSource="{Binding RestartOptions}" SelectedItem="{Binding FilterRestart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,10,0"/>

                    <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="保存配置" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,10,0">
                <DataGrid ItemsSource="{Binding ParametersView}"
                          SelectedItem="{Binding SelectedParameter, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="36"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#101E30"
                          Foreground="#DCEFFF"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="参数键" Binding="{Binding ParamKey}" Width="1.5*"/>
                        <DataGridTextColumn Header="参数名" Binding="{Binding ParamName}" Width="1.5*"/>
                        <DataGridTextColumn Header="参数值" Binding="{Binding ParamValue}" Width="*"/>
                        <DataGridTextColumn Header="数据类型" Binding="{Binding DataType}" Width="*"/>
                        <DataGridCheckBoxColumn Header="需重启" Binding="{Binding RequiresRestart}" Width="0.8*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="参数明细" Foreground="#00BFFF" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

                        <TextBlock Text="参数键" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding CurrentParameter.ParamKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" IsReadOnly="True" Background="#112233" Foreground="#8EA8C3"/>

                        <TextBlock Text="参数名称" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding CurrentParameter.ParamName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="参数值" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding CurrentParameter.ParamValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="数据类型" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding CurrentParameter.DataType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>

                        <CheckBox Content="修改需重启系统生效"
                                  IsChecked="{Binding CurrentParameter.RequiresRestart}"
                                  Foreground="#DCEFFF"
                                  Margin="0,2,0,14"/>

                        <TextBlock Text="参数说明" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding CurrentParameter.Description, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="72"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
