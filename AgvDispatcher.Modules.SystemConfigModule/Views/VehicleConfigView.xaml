<UserControl x:Class="AgvDispatcher.Modules.SystemConfigModule.Views.VehicleConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:behaviors="clr-namespace:AgvDispatcher.Modules.SystemConfigModule.Behaviors"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6F4FF"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxBaseStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#0D1724"/>
            <Setter Property="BorderBrush" Value="#1F3A60"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8EA8C3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#08111C"/>
            <Setter Property="BorderBrush" Value="#24507A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#12304A"/>
            <Setter Property="Foreground" Value="#DCEFFF"/>
            <Setter Property="BorderBrush" Value="#2D5D88"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#00BFFF"/>
            <Setter Property="Foreground" Value="#04101C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0B1828"/>
            <Setter Property="Foreground" Value="#DCEFFF"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#1F3A60"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#0A111E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="车辆配置" Foreground="#00BFFF" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#8EA8C3" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalCount, StringFormat=总数 {0}}" Foreground="#8EA8C3" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding EnabledCount, StringFormat=启用 {0}}" Foreground="#00FF7F" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    
                    <!-- Filters -->
                    <ComboBox ItemsSource="{Binding AvailableBrands}" SelectedItem="{Binding FilterBrand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding FilterStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding CapabilityOptions}" SelectedItem="{Binding FilterCapability, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,10,0"/>

                    <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="新增车辆" Command="{Binding AddCommand}" Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="复制" Command="{Binding CopyCommand}" Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="删除" Command="{Binding DeleteCommand}" Background="#FF4500" Foreground="White" BorderThickness="0" Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="保存配置" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,10,0">
                <DataGrid ItemsSource="{Binding VehiclesView}"
                          SelectedItem="{Binding SelectedVehicle, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="36"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#101E30"
                          Foreground="#DCEFFF"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="车辆编号" Binding="{Binding VehicleCode}" Width="1.2*"/>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="1.2*"/>
                        <DataGridTextColumn Header="品牌" Binding="{Binding Brand}" Width="*"/>
                        <DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="*"/>
                        <DataGridTextColumn Header="区域" Binding="{Binding AreaCode}" Width="0.7*"/>
                        <DataGridTextColumn Header="最高速度" Binding="{Binding MaxSpeed, StringFormat={}{0:F1} m/s}" Width="*"/>
                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="0.7*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="车辆档案" Foreground="#00BFFF" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="车辆ID" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding CurrentVehicle.VehicleId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="车辆编号" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding CurrentVehicle.VehicleCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="车辆名称" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding CurrentVehicle.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="品牌" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding CurrentVehicle.Brand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="型号" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding CurrentVehicle.Model, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="车辆类型" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding VehicleTypes}" SelectedItem="{Binding CurrentVehicle.Type}" Width="auto" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="所属区域" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding CurrentVehicle.AreaCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="IP地址" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding CurrentVehicle.IpAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="最高速度(m/s)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding CurrentVehicle.MaxSpeed, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="额定载重(kg)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding CurrentVehicle.RatedLoad, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F0}}" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="长(mm)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding CurrentVehicle.Length, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F0}}" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="宽(mm)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding CurrentVehicle.Width, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F0}}" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="高(mm)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding CurrentVehicle.Height, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F0}}" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="电池容量(Ah)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding CurrentVehicle.BatteryCapacityAh, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F0}}" Style="{StaticResource InputStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="适配器类型" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox IsEditable="True" ItemsSource="{Binding AdapterTypes}" Text="{Binding CurrentVehicle.AdapterType, UpdateSourceTrigger=PropertyChanged}" Width="auto" Margin="0,0,0,12" Height="32" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="协议类型" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox IsEditable="True" ItemsSource="{Binding ProtocolTypes}" Text="{Binding CurrentVehicle.ProtocolType, UpdateSourceTrigger=PropertyChanged}" Width="auto" Margin="0,0,0,12" Height="32" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="端点(IP/URL)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding CurrentVehicle.Endpoint, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="端口" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding CurrentVehicle.Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="导航方式" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox IsEditable="True" ItemsSource="{Binding NavigationTypes}" Text="{Binding CurrentVehicle.NavigationType, UpdateSourceTrigger=PropertyChanged}" Width="auto" Margin="0,0,0,12" Height="32" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="取放货方式" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox IsEditable="True" ItemsSource="{Binding LoadModes}" Text="{Binding CurrentVehicle.LoadMode, UpdateSourceTrigger=PropertyChanged}" Width="auto" Margin="0,0,0,12" Height="32" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="车辆能力(多选)" Style="{StaticResource FieldLabelStyle}"/>
                        <hc:CheckComboBox ItemsSource="{Binding CapabilityEnumValues}" SelectionMode="Multiple" behaviors:SelectedItemsBehavior.SelectedItems="{Binding CurrentVehicle.SelectedCapabilities}" ShowSelectAllButton="True" Width="auto" Margin="0,0,0,12" Height="32" HorizontalAlignment="Stretch"/>

                        <TextBlock Text="支持指令(多选)" Style="{StaticResource FieldLabelStyle}"/>
                        <hc:CheckComboBox ItemsSource="{Binding CommandEnumValues}" SelectionMode="Multiple" behaviors:SelectedItemsBehavior.SelectedItems="{Binding CurrentVehicle.SelectedCommands}" ShowSelectAllButton="True" Width="auto" Margin="0,0,0,12" Height="32" HorizontalAlignment="Stretch"/>


                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="默认停靠点" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox IsEditable="True" ItemsSource="{Binding AvailableNodeIds}" Text="{Binding CurrentVehicle.HomeNodeId, UpdateSourceTrigger=PropertyChanged}" Width="auto" Margin="0,0,0,12" Height="32" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="默认充电点" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox IsEditable="True" ItemsSource="{Binding AvailableNodeIds}" Text="{Binding CurrentVehicle.ChargeNodeId, UpdateSourceTrigger=PropertyChanged}" Width="auto" Margin="0,0,0,12" Height="32" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="最低派发电量(选填)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding CurrentVehicle.MinDispatchBattery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>

                        <CheckBox Content="启用该车辆"
                                  IsChecked="{Binding CurrentVehicle.IsEnabled}"
                                  Foreground="#DCEFFF"
                                  Margin="0,2,0,14"/>

                        <TextBlock Text="备注" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding CurrentVehicle.Remark, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="72"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
