<UserControl x:Class="AgvDispatcher.Modules.TaskConfigModule.Views.TaskConfigBottomPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#00BFFF"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxBaseStyle}">
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="5,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxBaseStyle}">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Width" Value="120"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#112233"/>
                <Setter Property="Foreground" Value="#00BFFF"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="#1F3A60"/>
            </Style>
            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="#1F3A60"/>
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#0A111E" BorderBrush="#00BFFF" BorderThickness="1" CornerRadius="4" Margin="15,0,15,20">
        <Border.Effect>
            <DropShadowEffect Color="#00BFFF" BlurRadius="5" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题区 -->
            <Grid Grid.Row="0" Margin="15,10,15,10">
                <TextBlock Text="▶ 模板详情 - 产线物料搬运" FontSize="16" FontWeight="Bold" Foreground="#00BFFF" HorizontalAlignment="Left"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#00FF7F" Margin="0,0,5,0"/>
                    <TextBlock Text="起点" Foreground="Gray" FontSize="12" Margin="0,0,15,0"/>

                    <Rectangle Width="10" Height="10" Fill="#00BFFF" Margin="0,0,5,0"/>
                    <TextBlock Text="任务节点" Foreground="Gray" FontSize="12" Margin="0,0,15,0"/>

                    <Polygon Points="5,0 10,5 5,10 0,5" Fill="#FFD700" Margin="0,0,5,0"/>
                    <TextBlock Text="条件分支" Foreground="Gray" FontSize="12" Margin="0,0,15,0"/>

                    <Border Width="10" Height="10" BorderBrush="#00FF7F" BorderThickness="2" Background="Transparent" Margin="0,0,5,0"/>
                    <TextBlock Text="结束" Foreground="Gray" FontSize="12"/>
                </StackPanel>
            </Grid>

            <Line Grid.Row="0" X1="0" Y1="40" X2="2000" Y2="40" Stroke="#1F3A60" StrokeThickness="1" VerticalAlignment="Bottom"/>

            <!-- 内容三分区 -->
            <Grid Grid.Row="1" Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- 左列：基本信息 -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="基本信息" Style="{StaticResource SectionTitleStyle}"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="模板名称:" Foreground="Gray" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="产线物料搬运" Height="32" VerticalContentAlignment="Center" hc:InfoElement.Placeholder="请输入模板名称" hc:InfoElement.Necessary="True"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="模板类型:" Foreground="Gray" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" SelectedIndex="0" Height="32" HorizontalAlignment="Left" >
                            <ComboBoxItem Content="搬运任务"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="优先级:" Foreground="Gray" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Content="高" Foreground="White" Background="Transparent" BorderThickness="0" Margin="0,0,10,0"/>
                            <RadioButton Content="中" Foreground="White" Background="Transparent" BorderThickness="0" IsChecked="True" Margin="0,0,10,0"/>
                            <RadioButton Content="低" Foreground="White" Background="Transparent" BorderThickness="0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="适用场景:" Foreground="Gray" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" SelectedIndex="0" Height="32" HorizontalAlignment="Left">
                            <ComboBoxItem Content="车间内物流"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="描述:" Foreground="Gray" VerticalAlignment="Top" Margin="0,5,0,0"/>
                        <TextBox Grid.Column="1" Text="用于生产线之间的物料自动转运1" Height="32" TextWrapping="Wrap" hc:InfoElement.Placeholder="请输入描述"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="状态:" Foreground="Gray" VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="1" IsChecked="True" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Left"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="标签:" Foreground="Gray" VerticalAlignment="Center"/>
                        <WrapPanel Grid.Column="1">
                            <Border Background="#1F3A60" CornerRadius="2" Padding="8,4" Margin="0,0,5,5">
                                <TextBlock Text="产线" Foreground="#00BFFF" FontSize="12"/>
                            </Border>
                            <Border Background="#1F3A60" CornerRadius="2" Padding="8,4" Margin="0,0,5,5">
                                <TextBlock Text="物料" Foreground="#00BFFF" FontSize="12"/>
                            </Border>
                            <Border Background="#1F3A60" CornerRadius="2" Padding="8,4" Margin="0,0,5,5">
                                <TextBlock Text="搬运" Foreground="#00BFFF" FontSize="12"/>
                            </Border>
                            <Border Background="Transparent" BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="8,4" Margin="0,0,0,5" Cursor="Hand">
                                <TextBlock Text="+" Foreground="Gray" FontSize="12"/>
                            </Border>
                        </WrapPanel>
                    </Grid>
                </StackPanel>

                <Line Grid.Column="0" X1="0" Y1="0" X2="0" Y2="500" Stroke="#1F3A60" StrokeThickness="1" HorizontalAlignment="Right" Margin="0,0,10,0"/>

                <!-- 中列：任务流程 -->
                <Grid Grid.Column="1" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="任务流程" Style="{StaticResource SectionTitleStyle}"/>

                    <!-- 流程图 -->
                    <Border Grid.Row="1" Background="#0C1522" BorderBrush="#1F3A60" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                        <Canvas Margin="10,35,10,0">
                            <!-- 连接线 -->
                            <Line X1="30" Y1="15" X2="500" Y2="15" Stroke="#1F3A60" StrokeThickness="2" StrokeDashArray="4 2"/>

                            <!-- 节点 -->
                            <StackPanel Canvas.Left="0" Canvas.Top="0">
                                <Ellipse Width="30" Height="30" Fill="#00FF7F" HorizontalAlignment="Center"/>
                                <TextBlock Text="开始" Foreground="White" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Canvas.Left="80" Canvas.Top="0">
                                <Border Width="40" Height="30" Background="#00BFFF" CornerRadius="4" HorizontalAlignment="Center">
                                    <TextBlock Text="接收1" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="接收任务" Foreground="White" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Canvas.Left="170" Canvas.Top="0">
                                <Border Width="40" Height="30" Background="#00BFFF" CornerRadius="4" HorizontalAlignment="Center">
                                    <TextBlock Text="移动" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="前往取货" Foreground="White" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Canvas.Left="260" Canvas.Top="0">
                                <Border Width="40" Height="30" Background="#00BFFF" CornerRadius="4" HorizontalAlignment="Center">
                                    <TextBlock Text="动作" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="取货" Foreground="White" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Canvas.Left="350" Canvas.Top="0">
                                <Border Width="40" Height="30" Background="#00BFFF" CornerRadius="4" HorizontalAlignment="Center">
                                    <TextBlock Text="移动" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="前往送货" Foreground="White" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Canvas.Left="440" Canvas.Top="0">
                                <Border Width="40" Height="30" Background="#00BFFF" CornerRadius="4" HorizontalAlignment="Center">
                                    <TextBlock Text="动作" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="放货" Foreground="White" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Canvas.Left="530" Canvas.Top="0">
                                <Border Width="30" Height="30" BorderBrush="#00FF7F" BorderThickness="2" CornerRadius="15" Background="Transparent" HorizontalAlignment="Center"/>
                                <TextBlock Text="结束" Foreground="White" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Canvas>
                    </Border>

                    <!-- 流程配置表格 -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding StepList}" AutoGenerateColumns="False" Background="Transparent" 
                              RowBackground="Transparent" AlternatingRowBackground="#0C1522" 
                              Foreground="White" GridLinesVisibility="None" BorderThickness="1" BorderBrush="#1F3A60" HeadersVisibility="Column"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="步骤" Binding="{Binding Step}" Width="40"/>
                            <DataGridTemplateColumn Header="节点类型" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Margin="0,0,5,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#00BFFF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NodeType}" Value="起点">
                                                                <Setter Property="Fill" Value="#00FF7F"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NodeType}" Value="结束">
                                                                <Setter Property="Fill" Value="#00FF7F"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding NodeType}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="节点名称" Binding="{Binding NodeName}" Width="*"/>
                            <DataGridTextColumn Header="动作配置" Binding="{Binding ActionConfig}" Width="*"/>
                            <DataGridTextColumn Header="参数配置" Binding="{Binding ParamConfig}" Width="*"/>
                            <DataGridTextColumn Header="超时(s)" Binding="{Binding Timeout}" Width="60"/>
                            <DataGridTemplateColumn Header="操作" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="编辑" Foreground="#00BFFF" Cursor="Hand" TextDecorations="Underline" Margin="0,0,10,0"/>
                                            <TextBlock Text="删除" Foreground="#FF4500" Cursor="Hand" TextDecorations="Underline"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Line Grid.Column="1" X1="0" Y1="0" X2="0" Y2="500" Stroke="#1F3A60" StrokeThickness="1" HorizontalAlignment="Right" Margin="0,0,10,0"/>

                <!-- 右列：触发规则与策略 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="触发规则" Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Text="触发方式:" Foreground="Gray" Margin="0,0,0,5"/>
                        <ComboBox SelectedIndex="0" Height="28" Margin="0,0,0,15">
                            <ComboBoxItem Content="系统触发"/>
                            <ComboBoxItem Content="人工触发"/>
                        </ComboBox>

                        <TextBlock Text="触发条件:" Foreground="Gray" Margin="0,0,0,5"/>
                        <Border Background="#0C1522" BorderBrush="#1F3A60" BorderThickness="1" CornerRadius="4" Padding="10">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="1. 库存低于阈值" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="✖" Foreground="#FF4500" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="2. 上层系统下发任务" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="✖" Foreground="#FF4500" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>
                                <Button Content="+ 添加条件" Background="Transparent" Foreground="#00BFFF" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="执行策略" Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,10"/>

                        <TextBlock Text="分配策略:" Foreground="Gray" Margin="0,0,0,5"/>
                        <ComboBox SelectedIndex="0" Height="28" Margin="0,0,0,15">
                            <ComboBoxItem Content="空闲优先"/>
                            <ComboBoxItem Content="距离优先"/>
                            <ComboBoxItem Content="电量优先"/>
                        </ComboBox>

                        <TextBlock Text="重试次数:" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox Text="3 次" Height="28" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                        <TextBlock Text="失败处理:" Foreground="Gray" Margin="0,0,0,5"/>
                        <ComboBox SelectedIndex="0" Height="28" Margin="0,0,0,15">
                            <ComboBoxItem Content="告警并重试"/>
                            <ComboBoxItem Content="挂起等待人工"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,10,0,0">
                        <Button Content="取消" Style="{StaticResource ButtonDashed}" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="保存" Style="{StaticResource ButtonPrimary}" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
