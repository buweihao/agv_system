<UserControl x:Class="AgvDispatcher.Modules.TaskModule.Views.TaskMainPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:core="clr-namespace:AgvDispatcher.Core.Enums;assembly=AgvDispatcher.Core"
             xmlns:local="clr-namespace:AgvDispatcher.Modules.TaskModule.Views"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="Transparent">
    
    <UserControl.Resources>
        <!-- DataGrid Styles -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#112233"/>
            <Setter Property="Foreground" Value="#00BFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#1F3A60"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#1F3A60"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A3B4C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxBaseStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxBaseStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NavTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,0,0,6"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#00BFFF"/>
                    <Setter Property="BorderBrush" Value="#00BFFF"/>
                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. 顶部导航与图例 -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <RadioButton x:Name="RbTaskList" Content="任务列表" IsChecked="True" Style="{StaticResource NavTabStyle}"/>
                <RadioButton x:Name="RbTaskStats" Content="任务统计" Style="{StaticResource NavTabStyle}"/>
                <RadioButton x:Name="RbTaskAnalysis" Content="任务分析" Style="{StaticResource NavTabStyle}" Margin="0"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="创建测试任务"
                        Command="{Binding CreateDemoTaskCommand}"
                        Background="#00BFFF"
                        Foreground="White"
                        BorderThickness="0"
                        Width="96"
                        Height="30"
                        Margin="0,0,12,0"
                        Cursor="Hand"/>
                <TextBlock Text="{Binding DispatchMessage}"
                           Foreground="#8FB8D8"
                           VerticalAlignment="Center"
                           Margin="0,0,18,0"/>
                <Ellipse Width="10" Height="10" Fill="#FFD700" Margin="0,0,5,0"/><TextBlock Text="待执行" Foreground="White" Margin="0,0,15,0"/>
                <Ellipse Width="10" Height="10" Fill="#00FF7F" Margin="0,0,5,0"/><TextBlock Text="运行中" Foreground="White" Margin="0,0,15,0"/>
                <Ellipse Width="10" Height="10" Fill="#2E8B57" Margin="0,0,5,0"/><TextBlock Text="已完成" Foreground="White" Margin="0,0,15,0"/>
                <Ellipse Width="10" Height="10" Fill="#FF4500" Margin="0,0,5,0"/><TextBlock Text="失败" Foreground="White" Margin="0,0,15,0"/>
                <Ellipse Width="10" Height="10" Fill="Gray" Margin="0,0,5,0"/><TextBlock Text="取消" Foreground="White"/>
            </StackPanel>
        </Grid>

        <!-- 内容区域 -->
        <Grid Grid.Row="1">
            <!-- TASK LIST VIEW -->
            <Grid x:Name="TaskListViewContent">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=RbTaskList}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

        <!-- 1.5. 任务创建约束 (测试区) -->
        <Border Grid.Row="0" Background="#0A111E" CornerRadius="4" Padding="10" Margin="0,0,0,15" BorderBrush="#1F3A60" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="测试任务参数：" Foreground="#00BFFF" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                
                <TextBlock Text="能力要求:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ItemsControl ItemsSource="{Binding CapabilityOptions}" Margin="0,0,15,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" 
                                      Foreground="#DCEFFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <TextBlock Text="允许品牌:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Text="{Binding AllowedBrands, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,15,0" ToolTip="例如: Brand A"/>
                
                <TextBlock Text="禁止品牌:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Text="{Binding ForbiddenBrands, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,15,0"/>
                
                <TextBlock Text="最低电量:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Text="{Binding MinBatteryRequired, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,15,0"/>
            </StackPanel>
        </Border>

        <!-- 2. 搜索过滤栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <ComboBox SelectedIndex="0"><ComboBoxItem Content="全部任务类型"/><ComboBoxItem Content="搬运任务"/><ComboBoxItem Content="充电任务"/></ComboBox>
                <ComboBox SelectedIndex="0"><ComboBoxItem Content="全部状态"/><ComboBoxItem Content="运行中"/><ComboBoxItem Content="已完成"/></ComboBox>
                <ComboBox SelectedIndex="0"><ComboBoxItem Content="全部优先级"/><ComboBoxItem Content="高"/><ComboBoxItem Content="中"/><ComboBoxItem Content="低"/></ComboBox>
                <ComboBox SelectedIndex="0"><ComboBoxItem Content="全部AGV"/><ComboBoxItem Content="AGV-001"/><ComboBoxItem Content="AGV-002"/></ComboBox>
                <TextBox Width="150" Margin="0,0,10,0" Text="请选择创建时间" Foreground="Gray"/> <!-- Fake DatePicker to avoid complex styling overhead -->
                <TextBox Width="200" Margin="0,0,10,0" Text="输入任务ID/起点/终点"/>
                
                <Button Content="搜索" Background="#00BFFF" Foreground="White" BorderThickness="0" Width="60" Height="30" Margin="0,0,10,0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="2"/></Style></Button.Resources>
                </Button>
                <Button Content="重置" Background="#1F3A60" Foreground="White" BorderThickness="0" Width="60" Height="30" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="2"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 3. 数据表格 -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding PagedTaskList}" AutoGenerateColumns="False" Background="Transparent" 
                  RowBackground="Transparent" AlternatingRowBackground="#0A111E" 
                  Foreground="White" GridLinesVisibility="None" BorderThickness="0" HeadersVisibility="Column"
                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="任务ID" Binding="{Binding Id}" Width="*"/>
                <DataGridTextColumn Header="任务类型" Binding="{Binding Type}" Width="*"/>
                
                <!-- 优先级列 -->
                <DataGridTemplateColumn Header="优先级" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" CornerRadius="2" Padding="8,2" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Priority}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Priority}" Value="高">
                                                <Setter Property="BorderBrush" Value="#FF4500"/>
                                                <Setter Property="TextBlock.Foreground" Value="#FF4500"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Priority}" Value="中">
                                                <Setter Property="BorderBrush" Value="#FFD700"/>
                                                <Setter Property="TextBlock.Foreground" Value="#FFD700"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Priority}" Value="低">
                                                <Setter Property="BorderBrush" Value="#00BFFF"/>
                                                <Setter Property="TextBlock.Foreground" Value="#00BFFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 状态列 -->
                <DataGridTemplateColumn Header="状态" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StateDisplay}" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static core:TaskState.Pending}">
                                                <Setter Property="Foreground" Value="#FFD700"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static core:TaskState.Running}">
                                                <Setter Property="Foreground" Value="#00FF7F"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static core:TaskState.Completed}">
                                                <Setter Property="Foreground" Value="#2E8B57"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static core:TaskState.Failed}">
                                                <Setter Property="Foreground" Value="#FF4500"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static core:TaskState.Cancelled}">
                                                <Setter Property="Foreground" Value="Gray"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static core:TaskState.Interrupted}">
                                                <Setter Property="Foreground" Value="#FF8C00"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="AGV编号" Binding="{Binding AgvId}" Width="*"/>
                <DataGridTemplateColumn Header="派发状态" Width="1.2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="可派发" Foreground="#00FF7F" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDispatchPaused}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding DispatchPauseReason}" Foreground="#FFD700" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDispatchPaused}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="起点" Binding="{Binding StartPoint}" Width="*"/>
                <DataGridTextColumn Header="终点" Binding="{Binding EndPoint}" Width="*"/>
                <DataGridTemplateColumn Header="进度" Width="1.2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Height="18">
                                <Border Background="#112233" CornerRadius="2"/>
                                <ProgressBar Value="{Binding ProgressPercent}"
                                             Maximum="100"
                                             Height="18"
                                             Background="Transparent"
                                             Foreground="#00BFFF"
                                             BorderThickness="0"/>
                                <TextBlock Text="{Binding ProgressText}"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedTime}" Width="1.5*"/>
                <DataGridTextColumn Header="预计完成" Binding="{Binding EstimatedTime}" Width="1.5*"/>
                
                <DataGridTemplateColumn Header="操作" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!-- 正常状态时的派发按钮 -->
                                <Button Content="自动派发"
                                        Command="{Binding DataContext.AutoDispatchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="#00BFFF"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="10,4"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="2"/></Style></Button.Resources>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static core:TaskState.Pending}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                
                                <!-- 中断时的三个操作按钮 -->
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static core:TaskState.Interrupted}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    
                                    <Button Content="重派发" Command="{Binding DataContext.RetryInterruptedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#00BFFF" Foreground="White" BorderThickness="0" Padding="5,2" Margin="0,0,5,0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="2"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="标失败" Command="{Binding DataContext.FailInterruptedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#FF4500" Foreground="White" BorderThickness="0" Padding="5,2" Margin="0,0,5,0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="2"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="强完成" Command="{Binding DataContext.CompleteInterruptedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#2E8B57" Foreground="White" BorderThickness="0" Padding="5,2" Margin="0,0,5,0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="2"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="取消" Command="{Binding DataContext.CancelInterruptedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="Gray" Foreground="White" BorderThickness="0" Padding="5,2" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="2"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 4. 底部分页栏 -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <TextBlock Text="{Binding TotalRecordText}" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ComboBox ItemsSource="{Binding PageSizeOptions}"
                          SelectedItem="{Binding PageSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Width="80"
                          Margin="0,0,15,0"/>
                
                <Button Content="&lt;" Command="{Binding PreviousPageCommand}" Background="Transparent" Foreground="Gray" BorderBrush="#1F3A60" BorderThickness="1" Width="30" Height="30" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding PageSummaryText}" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="&gt;" Command="{Binding NextPageCommand}" Background="Transparent" Foreground="Gray" BorderBrush="#1F3A60" BorderThickness="1" Width="30" Height="30"/>
            </StackPanel>
        </Grid>
            </Grid>

            <!-- TASK STATISTICS VIEW -->
            <local:TaskStatisticsView>
                <local:TaskStatisticsView.Style>
                    <Style TargetType="UserControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=RbTaskStats}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:TaskStatisticsView.Style>
            </local:TaskStatisticsView>

            <!-- TASK ANALYSIS VIEW -->
            <local:TaskAnalysisView>
                <local:TaskAnalysisView.Style>
                    <Style TargetType="UserControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=RbTaskAnalysis}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:TaskAnalysisView.Style>
            </local:TaskAnalysisView>
        </Grid>
    </Grid>
</UserControl>
