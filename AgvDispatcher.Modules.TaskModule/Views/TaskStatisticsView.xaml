<UserControl x:Class="AgvDispatcher.Modules.TaskModule.Views.TaskStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#00BFFF"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#0F1A2A"/>
            <Setter Property="BorderBrush" Value="#1F3A60"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,15,15"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="统计周期:" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Width="120" SelectedIndex="0" Background="#1F3A60" Foreground="White" BorderThickness="0" Height="28">
                <ComboBoxItem Content="本周"/>
                <ComboBoxItem Content="本月"/>
                <ComboBoxItem Content="本年"/>
            </ComboBox>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 任务执行效率 -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="▶ 任务执行效率" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid Margin="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="平均耗时" Foreground="Gray" HorizontalAlignment="Center"/>
                            <TextBlock Text="12.5 min" Foreground="#00BFFF" FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="准时完成率" Foreground="Gray" HorizontalAlignment="Center"/>
                            <TextBlock Text="94.2 %" Foreground="#00FF7F" FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="超时任务数" Foreground="Gray" HorizontalAlignment="Center"/>
                            <TextBlock Text="18" Foreground="#FF4500" FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- AGV 负载均衡 -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="▶ AGV 负载均衡" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid Margin="0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="AGV-001" Foreground="White" HorizontalAlignment="Left"/>
                            <TextBlock Text="86%" Foreground="#00FF7F" HorizontalAlignment="Right"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="86" Height="6" Margin="60,0,40,0" Background="#112233" Foreground="#00FF7F" BorderThickness="0"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <TextBlock Text="AGV-002" Foreground="White" HorizontalAlignment="Left"/>
                            <TextBlock Text="42%" Foreground="#FFD700" HorizontalAlignment="Right"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="42" Height="6" Margin="60,0,40,0" Background="#112233" Foreground="#FFD700" BorderThickness="0"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <TextBlock Text="AGV-003" Foreground="White" HorizontalAlignment="Left"/>
                            <TextBlock Text="95%" Foreground="#FF4500" HorizontalAlignment="Right"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="95" Height="6" Margin="60,0,40,0" Background="#112233" Foreground="#FF4500" BorderThickness="0"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 异常统计图表 (Placeholder) -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardBorderStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="▶ 任务异常趋势" Style="{StaticResource SectionTitleStyle}"/>
                    <Border Background="#112233" CornerRadius="4" Height="200" Margin="0,10,0,0">
                        <TextBlock Text="[图表区域] 柱状图：展示各类型异常在过去7天的分布情况" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
