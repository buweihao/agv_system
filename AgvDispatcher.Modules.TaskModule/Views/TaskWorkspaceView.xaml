<UserControl x:Class="AgvDispatcher.Modules.TaskModule.Views.TaskWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:core="clr-namespace:AgvDispatcher.Core.Constants;assembly=AgvDispatcher.Core"
             xmlns:local="clr-namespace:AgvDispatcher.Modules.TaskModule.Views"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧列 -->
        <Grid Grid.Column="0" Background="#112233" Margin="10">
            <local:TaskLeftPanelView />
        </Grid>

        <!-- 右侧列 -->
        <Grid Grid.Column="1" Margin="0,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="280" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#1A2B3C" Margin="0,0,0,10">
                <local:TaskMainPanelView x:Name="mainPanelView" />
            </Grid>

            <Grid Grid.Row="1" Background="#0F1A24">
                <local:TaskDetailView DataContext="{Binding DataContext.SelectedTask, ElementName=mainPanelView}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
