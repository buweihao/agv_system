<Window x:Class="WpfApp16.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WpfApp16.ViewModels"
        mc:Ignorable="d"
        Title="AGV HTTP 接口测试工具" Height="700" Width="1100"
        Background="#1E1E2E" Foreground="#FFFFFF"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#45475A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#585B70"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#89B4FA" Offset="0"/>
                        <GradientStop Color="#B4BEFE" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#11111B"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#CBA6F7" Offset="0"/>
                        <GradientStop Color="#F5C2E7" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#11111B"/>
        </Style>

        <!-- Modern TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#89B4FA"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#BAC2DE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Config Area -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Client Config -->
            <Border Grid.Column="0" Background="#313244" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="客户端配置 (Client Configuration)" Style="{StaticResource LabelStyle}" Foreground="#A6ADC8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Config.BaseUrl, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="0" Text="Target Base URL" VerticalAlignment="Center" Margin="10,0" 
                                   Foreground="#585B70" IsHitTestVisible="False" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Server Config -->
            <Border Grid.Column="2" Background="#313244" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="服务端监听配置 (Server Listener)" Style="{StaticResource LabelStyle}" Foreground="#A6ADC8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Config.ListenUrl, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="14" FontWeight="Medium" VerticalAlignment="Center" IsReadOnly="{Binding IsListening}"/>
                        <TextBlock Grid.Column="0" Text="Listen URL" VerticalAlignment="Center" Margin="10,0" 
                                   Foreground="#585B70" IsHitTestVisible="False" FontWeight="Bold" HorizontalAlignment="Right"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                            <Button Content="启动监听" Command="{Binding StartListenCommand}" 
                                    Style="{StaticResource ActionButtonStyle}" Padding="10,5" Margin="0,0,5,0"/>
                            <Button Content="停止" Command="{Binding StopListenCommand}" 
                                    Style="{StaticResource ModernButtonStyle}" Background="#F38BA8" Foreground="#11111B" Padding="10,5"/>
                        </StackPanel>
                    </Grid>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="状态: " Foreground="#BAC2DE" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ListenStatusText}" Foreground="{Binding ListenStatusColor}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Operation Area -->
            <Border Grid.Column="0" Background="#181825" CornerRadius="12" Padding="20" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="业务参数 (Business Parameters)" FontWeight="Bold" FontSize="18" Margin="0,0,0,20" Foreground="#89B4FA"/>

                        <!-- Task ID -->
                        <TextBlock Text="Task ID" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding TaskId, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="刷新" Command="{Binding GenerateTaskIdCommand}" 
                                    Margin="5,0,0,0" Padding="10,0" Style="{StaticResource ModernButtonStyle}"/>
                        </Grid>

                        <!-- Source -->
                        <TextBlock Text="Source (取货点)" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                        <!-- Target -->
                        <TextBlock Text="Target (卸货点)" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                        <!-- Area ID -->
                        <TextBlock Text="Area ID (管制区域)" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding AreaId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                        <!-- AGV ID -->
                        <TextBlock Text="AGV ID (车辆编号)" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding AgvId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                        <!-- Request Type -->
                        <TextBlock Text="Request Type (1:进入, 2:离开)" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding RequestType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,30"/>

                        <!-- Buttons -->
                        <TextBlock Text="动作指令 (Actions)" FontWeight="Bold" FontSize="16" Margin="0,0,0,15" Foreground="#CBA6F7"/>
                        
                        <Button Content="1. 获取所有 AGV 信息" Command="{Binding GetAgvInfosCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,10"/>
                        
                        <Button Content="2. 下发运输任务" Command="{Binding TaskDownloadCommand}" 
                                Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,10"/>

                        <Button Content="3. 获取任务列表" Command="{Binding GetTaskInfosCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,10"/>
                        
                        <Button Content="4. 删除指定任务" Command="{Binding DeleteTaskCommand}" 
                                Style="{StaticResource ModernButtonStyle}" Background="#F38BA8" Foreground="#11111B" Margin="0,0,0,10"/>

                        <Button Content="5. 请求进入/离开管制区" Command="{Binding RequestControlCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: Log Area -->
            <Border Grid.Column="1" Background="#11111B" CornerRadius="12" Padding="15" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                        <TextBlock Text="通信日志 (Communication Logs)" FontWeight="Bold" FontSize="18" Foreground="#FAB387" VerticalAlignment="Center"/>
                        <Button Content="清空日志" Command="{Binding ClearLogCommand}" DockPanel.Dock="Right" Style="{StaticResource ModernButtonStyle}" FontSize="12" Padding="10,5"/>
                    </DockPanel>

                    <TextBox Grid.Row="1" x:Name="LogTextBox"
                             Text="{Binding LogContent, Mode=OneWay}" 
                             IsReadOnly="True" 
                             AcceptsReturn="True" 
                             VerticalScrollBarVisibility="Auto" 
                             FontFamily="Cascadia Code, Consolas, Monospace" 
                             FontSize="13" 
                             Background="Transparent" 
                             BorderThickness="0"
                             TextChanged="LogTextBox_TextChanged"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
